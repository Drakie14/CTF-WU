---
import EmptyState from '../components/EmptyState.astro';
import PostRow from '../components/PostRow.astro';
import AppLayout from '../layouts/AppLayout.astro';
import { SITE } from '../config/site';
import { getSiteContent } from '../lib/posts';

const { posts } = await getSiteContent();
const latest = posts.slice(0, 5);
---

<AppLayout view="home" title={SITE.name}>
  <EmptyState title="Select a write-up" description={SITE.description}>
    {
      latest.length > 0 && (
        <section class="latest" aria-labelledby="latest-h">
          <h2 id="latest-h">Mới nhất</h2>
          <ul>
            {latest.map((p) => <PostRow post={p} />)}
          </ul>
        </section>
      )
    }
  </EmptyState>
</AppLayout>

<style>
  .latest {
    width: min(100%, 36rem);
    margin-top: 2.5rem;
    text-align: left;
  }
  .latest h2 {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .latest ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .latest :global(li) {
      animation: rise 0.6s var(--ease-out) backwards;
    }
    .latest :global(li:nth-child(1)) { animation-delay: 0.45s; }
    .latest :global(li:nth-child(2)) { animation-delay: 0.51s; }
    .latest :global(li:nth-child(3)) { animation-delay: 0.57s; }
    .latest :global(li:nth-child(4)) { animation-delay: 0.63s; }
    .latest :global(li:nth-child(5)) { animation-delay: 0.69s; }
    .latest :global(.row) {
      transition:
        background-color 0.15s,
        transform 0.3s var(--ease-out);
    }
    .latest :global(.row:hover) {
      transform: translateX(4px);
    }
  }
</style>
