---
import Activity from '../components/Activity.astro';
import PostRow from '../components/PostRow.astro';
import WebRank from '../components/WebRank.astro';
import AppLayout from '../layouts/AppLayout.astro';
import { SITE } from '../config/site';
import { CATEGORY_META, categoryColor } from '../lib/categories';
import { CATEGORIES } from '../lib/content/constants';
import { formatIsoDate } from '../lib/content/dates';
import { getSiteContent, postUrl } from '../lib/posts';
import { activityGrid, webRank } from '../lib/stats';

const { posts } = await getSiteContent();
const latest = posts.slice(0, 5);
const rank = webRank(posts.filter((p) => p.data.category === 'web').map((p) => p.data.difficulty));
// "Hôm nay" là ngày build: site build lại mỗi lần publish nên lưới luôn kết thúc ở bài mới nhất.
const activity = activityGrid(posts.map((p) => ({ iso: formatIsoDate(p.data.date), title: p.data.title, href: postUrl(p) })), formatIsoDate(new Date()), 26);
const uncategorized = posts.filter((p) => !p.data.category).length;
const categories = [
  ...CATEGORIES.map((key) => ({ key, label: CATEGORY_META[key].label, color: CATEGORY_META[key].color, href: `/category/${key}/`, count: posts.filter((p) => p.data.category === key).length })),
  { key: 'none', label: 'Khác', color: categoryColor(''), count: uncategorized },
]
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);
---

<AppLayout view="home" title={SITE.name}>
  <div class="home">
    <header class="hero">
      <svg class="hero-icon" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M24 4 44 24 24 44 4 24Z" fill="none" stroke="currentColor" stroke-width="2.5"></path>
        <path d="M24 15 33 24 24 33 15 24Z" fill="currentColor"></path>
      </svg>
      <div>
        <h1>{SITE.author}</h1>
        <p>{SITE.description}</p>
        <a class="learn-link" href="/learn/">Đọc theo lộ trình →</a>
      </div>
    </header>

    <form class="home-search" action="/search/" method="get" role="search" aria-label="Tìm write-up">
      <label for="home-q">Tìm write-up</label>
      <div class="home-search-field">
        <input id="home-q" name="q" type="search" placeholder="Tiêu đề, nội dung hoặc kỹ thuật…" data-home-search-input />
        <button type="submit">Tìm</button>
      </div>
    </form>

    {
      latest.length > 0 && (
        <section class="latest" aria-labelledby="latest-h">
          <h2 id="latest-h">Mới nhất</h2>
          <ul>
            {latest.map((p) => <PostRow post={p} />)}
          </ul>
        </section>
      )
    }

    <div class="desktop-stats">
      {posts.length > 0 && <WebRank rank={rank} />}
      {posts.length > 0 && <Activity {...activity} categories={categories} />}
    </div>
  </div>
</AppLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-sizing: border-box;
    width: min(100%, 48rem);
    margin: 0 auto;
    padding: clamp(2rem, 5vh, 3rem) 1.5rem 3rem;
  }
  .learn-link { display:inline-block; margin-top:.65rem; color:var(--accent); font-size:.85rem; text-underline-offset:.3em; }
  .desktop-stats {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  .home-search {
    display: none;
  }
  .home-search label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .home-search-field {
    display: flex;
    gap: 0.5rem;
  }
  .home-search input {
    min-width: 0;
    flex: 1;
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--panel-border);
    border-radius: 0.6rem;
    background: var(--panel-2);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }
  .home-search input::placeholder {
    color: var(--muted);
  }
  .home-search button {
    padding: 0.7rem 1rem;
    border: 0;
    border-radius: 0.6rem;
    background: var(--accent);
    color: #1a0b14;
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
  }
  .home-search button:active {
    transform: scale(0.98);
  }
  .hero {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .hero-icon {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    color: var(--accent);
  }
  .hero h1 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
  }
  .hero p {
    margin: 0.2rem 0 0;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
  .latest h2 {
    margin: 0.4rem 0 0.6rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-soft);
  }
  .latest ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .latest :global(.row) {
      transition:
        background-color 0.15s,
        transform 0.3s var(--ease-out);
    }
    .latest :global(.row:hover) {
      transform: translateX(4px);
    }
  }
  @media (max-width: 1023.98px) {
    .home {
      box-sizing: border-box;
      padding: 1.5rem 1rem;
      gap: 1rem;
    }
    .desktop-stats {
      display: none;
    }
    .home-search {
      display: block;
    }
    .latest :global(li:nth-child(n + 4)) {
      display: none;
    }
    .hero p {
      font-size: 0.85rem;
    }
  }
</style>
