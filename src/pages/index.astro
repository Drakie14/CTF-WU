---
import EmptyState from '../components/EmptyState.astro';
import AppLayout from '../layouts/AppLayout.astro';
import { SITE } from '../config/site';
import { formatDisplayDate } from '../lib/content/dates';
import { getSiteContent, postUrl } from '../lib/posts';

const { posts } = await getSiteContent();
const latest = posts.slice(0, 5);
---

<AppLayout view="home" title={SITE.name}>
  <EmptyState title="Select a write-up" description={SITE.description}>
    {
      latest.length > 0 && (
        <section class="latest" aria-labelledby="latest-h">
          <h2 id="latest-h">Mới nhất</h2>
          <ul>
            {latest.map((p) => (
              <li>
                <a href={postUrl(p)}>
                  <span class="l-title">{p.data.title}</span>
                  <span class="l-meta">
                    {p.data.ctf || 'Chưa phân loại'} · {formatDisplayDate(p.data.date)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </EmptyState>
</AppLayout>

<style>
  .latest {
    width: min(100%, 30rem);
    margin-top: 2.5rem;
    text-align: left;
  }
  .latest h2 {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .latest ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--panel-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  .latest li + li {
    border-top: 1px solid var(--panel-border);
  }
  .latest a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    text-decoration: none;
    background: var(--panel-2);
  }
  .latest a:hover {
    background: #2a2a31;
  }
  @media (prefers-reduced-motion: no-preference) {
    .latest li {
      animation: rise 0.6s var(--ease-out) backwards;
    }
    .latest li:nth-child(1) { animation-delay: 0.45s; }
    .latest li:nth-child(2) { animation-delay: 0.51s; }
    .latest li:nth-child(3) { animation-delay: 0.57s; }
    .latest li:nth-child(4) { animation-delay: 0.63s; }
    .latest li:nth-child(5) { animation-delay: 0.69s; }
    .latest a {
      transition:
        background-color 0.15s,
        transform 0.3s var(--ease-out);
    }
    .latest a:hover {
      transform: translateX(4px);
    }
  }
  .l-title {
    color: var(--text);
  }
  .l-meta {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
