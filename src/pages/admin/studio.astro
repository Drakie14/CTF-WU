---
import { CATEGORY_META } from '../../lib/categories';
import { CATEGORIES, DIFFICULTIES, difficultyFamily } from '../../lib/content/constants';
import { getSiteContent } from '../../lib/posts';

// Tag của mọi bài lúc build: làm từ điển cho "Tự thêm tags" khi chưa đọc được bài nào từ GitHub.
const { tags: taxonomy, posts } = await getSiteContent();
const tagVocabulary = JSON.stringify(taxonomy.terms.map(({ name, count }) => ({ name, count }))).replace(/</g, '\\u003c');
// Bài đã gắn tag: few-shot cho Gemini bắt đúng cách gắn tag của tác giả.
const tagExamples = JSON.stringify(posts.filter((post) => post.data.tags.length).map(({ data }) => ({ title: data.title, category: data.category, tags: data.tags }))).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Write-up Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="studio">
      <header class="topbar">
        <div class="brand-actions">
          <button type="button" class="icon-button" data-sidebar-toggle aria-label="Thu gọn thư viện" title="Thu gọn thư viện">☰</button>
          <a class="wordmark" href="/admin/studio/">CTF<span>//</span>WU <small>Studio</small></a>
          <button type="button" class="connection-pill" data-connection title="GitHub chưa kết nối"><i></i><span>GitHub</span></button>
        </div>
        <div class="top-actions">
          <a href="/admin/import/">Import cả giải</a>
          <button type="button" class="local-root" data-local-connect title="Chọn thư mục D:\Hiếu\Blog\src\content\posts để đồng bộ bài local">Local chưa kết nối</button>
          <button type="button" class="publish" data-publish>Publish</button>
        </div>
      </header>

      <aside class="library" aria-label="Thư viện write-up">
        <div class="library-head">
          <div>
            <p class="eyebrow">Write-up library</p>
            <strong data-repo>Đang đọc cấu hình…</strong>
          </div>
          <button type="button" title="Tải lại danh sách" aria-label="Tải lại danh sách" data-reload>↻</button>
        </div>
        <div class="token-box" data-token-box hidden>
          <label for="token">GitHub token</label>
          <input id="token" type="password" autocomplete="off" placeholder="github_pat_…" data-token />
          <button type="button" data-connect>Kết nối</button>
          <p>Token được lưu trong trình duyệt này để Studio publish vào repository.</p>
        </div>
        <button type="button" class="new-file" data-new data-sidebar-new hidden>+ Bài viết mới</button>
        <nav class="tree" aria-label="Danh sách bài" data-tree>
          <p class="empty-tree">Kết nối GitHub để mở danh sách bài.</p>
        </nav>
      </aside>

      <section class="workspace" aria-label="Soạn write-up">
        <section class="library-home" data-library-home>
          <div class="browser-head">
            <div class="browser-title"><nav class="crumbs" aria-label="Đường dẫn folder" data-library-path></nav><h1 data-library-title>Thư mục write-up</h1></div>
            <div class="browser-actions">
              <button type="button" class="back-folder" data-folder-back hidden>← Lên trên</button>
              <button type="button" class="create-subfolder" data-folder-create>+ Folder mới</button>
              <button type="button" class="create-folder" data-new data-folder-new hidden>+ Tạo write-up</button>
            </div>
          </div>
          <div class="pending-bar" data-pending-bar hidden>
            <span data-pending-count></span>
            <button type="button" data-pending-discard>Hủy</button>
            <button type="button" data-pending-save>Save</button>
          </div>
          <div class="selection-bar" data-selection-bar hidden>
            <span data-selection-summary></span>
            <button type="button" data-visibility="hide">Ẩn khỏi blog</button>
            <button type="button" data-visibility="show">Hiện trên blog</button>
            <button type="button" data-folder-rename>Đổi tên folder</button>
            <button type="button" data-selection-clear>Bỏ chọn</button>
          </div>
          <p class="status library-status" role="status" data-library-status></p>
          <div class="folder-grid" data-folder-grid><p class="empty-tree">Kết nối GitHub để tải thư mục.</p></div>
          <div class="library-empty" data-folder-empty hidden><strong>Folder này đang trống</strong><span>Tạo folder con hoặc write-up đầu tiên ngay bên trong.</span></div>
          <section class="folder-posts" data-folder-posts hidden><h2 data-folder-posts-title>Bài trong folder</h2><div class="recent-grid" data-folder-files></div></section>
        </section>

        <section class="composer" data-composer hidden>
          <div class="editor-tools">
            <button type="button" class="back-library" data-library>← Thư mục</button>
            <strong data-file-label>Write-up mới</strong>
            <span data-save-state>Chưa publish</span>
            <button type="button" data-stale-draft hidden title="Nháp này viết trên bản cũ hơn bản đang có trên GitHub">Mở nháp cũ</button>
            <button type="button" data-metadata-toggle>Thông tin bài</button>
          </div>

          <details class="metadata" data-metadata>
            <summary><span>Thông tin bài viết</span><i aria-hidden="true">×</i></summary>
            <div class="meta-body">
              <input class="meta-title" type="text" data-title placeholder="Tên challenge" aria-label="Tiêu đề" />
              <div class="meta-line">
                <label class="meta-field meta-folder" title="Thư mục trong src/content/posts"><span>Thư mục</span><input type="text" data-folder value="Dreamhack" placeholder="Dreamhack" /></label>
                <label class="meta-field"><span>CTF</span><input type="text" data-ctf placeholder="Dreamhack" /></label>
                <label class="meta-field meta-date"><span>Ngày</span><input type="date" data-date /></label>
              </div>
              <div class="meta-row">
                <span class="meta-key" id="meta-category">Category</span>
                <div class="meta-chips" role="group" aria-labelledby="meta-category" data-chip-group="category">
                  {CATEGORIES.map((c) => <button type="button" data-chip={c} aria-pressed="false" style={`--c:${CATEGORY_META[c].color}`}>{CATEGORY_META[c].label}</button>)}
                </div>
                <input type="hidden" data-category />
              </div>
              <div class="meta-row">
                <span class="meta-key" id="meta-difficulty">Độ khó</span>
                <div class="meta-chips" role="group" aria-labelledby="meta-difficulty" data-chip-group="difficulty">
                  {DIFFICULTIES.map((d) => <button type="button" data-chip={d} aria-pressed="false" class={`diff-${difficultyFamily(d)}`}>{d}</button>)}
                </div>
                <input type="hidden" data-difficulty />
              </div>
              <div class="meta-row meta-tags">
                <label class="meta-key" for="tag-entry">Tags</label>
                <div class="tag-box">
                  <ul class="tag-chips" data-tag-chips></ul>
                  <input id="tag-entry" class="tag-entry" type="text" data-tag-entry list="tag-options" autocomplete="off" placeholder="Thêm tag…" />
                  <datalist id="tag-options" data-tag-options></datalist>
                  <input type="hidden" data-tags />
                </div>
                <button type="button" class="suggest-tags" data-auto-tags title="Gemini đọc cả bài rồi chọn tag; chưa có key thì dùng gợi ý offline.">Gợi ý tags</button>
              </div>
              <p class="tag-note" data-tag-note hidden></p>
              <details class="ai-key" data-ai-key>
                <summary>Gemini API key <em data-ai-key-state>chưa có</em></summary>
                <input type="password" autocomplete="off" placeholder="AIza…" aria-label="Gemini API key" data-gemini-key />
                <p>Lấy key miễn phí ở <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener noreferrer">aistudio.google.com/apikey</a>, chỉ lưu trong trình duyệt này. Studio hỏi Gemini 3.8 Flash (model free mạnh nhất), hết lượt thì tự chuyển 2.5 Pro, 3.6 Flash, 2.5 Flash.</p>
              </details>
              <script is:inline type="application/json" data-tag-vocabulary set:html={tagVocabulary}></script>
              <script is:inline type="application/json" data-tag-examples set:html={tagExamples}></script>
            </div>
          </details>

          <div class="markdown-tools" aria-label="Công cụ Markdown">
            <button type="button" data-markdown="heading">H2</button><button type="button" data-markdown="bold"><b>B</b></button><button type="button" data-markdown="link">Link</button><button type="button" data-markdown="code">Code</button><button type="button" data-markdown="info">Info</button><button type="button" data-markdown="warning">Warning</button><button type="button" data-markdown="footnote">Footnote</button><button type="button" data-markdown="highlight">Highlight</button><button type="button" data-markdown="latex">LaTeX</button><button type="button" data-markdown="mermaid">Mermaid</button><button type="button" data-markdown="sup">Sup</button><button type="button" data-markdown="sub">Sub</button><button type="button" data-markdown="toc">Mục lục</button><button type="button" data-markdown="youtube">YouTube</button><button type="button" data-markdown="task">Task</button><button type="button" data-markdown="quote">Quote</button>
          </div>

          <div class="editor-grid">
            <section class="source-pane">
              <div class="pane-head"><span>Markdown</span><span class="editor-keys" tabindex="0" title="Tab / Shift+Tab: thụt lề (dòng list thành list con)&#10;Bôi đen rồi gõ ` [ ( { &quot; * _ ~ = $ &lt;: bọc vùng chọn (` trên nhiều dòng thành code block)&#10;Ctrl+B đậm · Ctrl+I nghiêng · Ctrl+E code · Ctrl+Shift+X gạch · Ctrl+K link&#10;Bôi đen chữ rồi dán URL: thành link&#10;Ctrl+F tìm / thay · Ctrl+D chọn chữ giống tiếp theo&#10;Alt+↑/↓ chuyển dòng · Shift+Alt+↑/↓ nhân đôi dòng · Ctrl+Z / Ctrl+Shift+Z hoàn tác&#10;Ctrl+V ảnh để chèn">Ctrl+V ảnh · Phím tắt ⓘ</span></div>
              <div class="code-editor" data-editor></div>
              <div class="asset-drawer" data-assets-drawer hidden>
                <label class="asset-filter"><input type="checkbox" data-assets-unused /> Chỉ hiện chưa dùng</label>
                <ul class="assets" data-assets-list></ul>
              </div>
              <div class="asset-bar">
                <button type="button" class="asset-toggle" data-assets-toggle aria-expanded="false" aria-label="Mở kho tệp"><span data-assets-count>📎 0 tệp</span><i>▴</i></button>
                <button type="button" class="asset-add" data-assets-add aria-label="Thêm tệp" title="Thêm tệp">＋</button>
                <input type="file" multiple hidden data-assets accept="image/*,.svg,.txt,.py,.js,.ts,.zip,.pdf" />
              </div>
              <div class="drop-overlay" data-drop-overlay hidden>Thả để thêm</div>
            </section>
            <div class="resize-handle" data-resize aria-label="Kéo để đổi độ rộng editor" role="separator" aria-orientation="vertical"></div>
            <section class="preview-pane">
              <div class="pane-head"><span>Preview</span><span class="pane-tools"><button type="button" class="sync-mode" data-sync-mode data-mode="follow" title="Cuộn đồng bộ theo dòng nguồn: bấm để đổi chế độ">↕ Cuộn + con trỏ</button><span data-preview-state>Đang chờ nội dung</span></span></div>
              <article class="preview" data-preview><p class="placeholder">Preview Markdown sẽ hiện ở đây.</p></article>
            </section>
          </div>
          <p class="status" role="status" data-status></p>
          <div class="tag-toast" data-tag-toast hidden>
            <section class="toast-card" role="dialog" aria-modal="true" aria-labelledby="toast-title" aria-live="polite">
              <button type="button" class="toast-close" data-toast-close aria-label="Đóng">×</button>
              <strong id="toast-title" data-toast-title></strong>
              <span class="toast-post">Bài: <b data-toast-post></b></span>
              <ul class="toast-tags" data-toast-tags></ul>
              <p data-toast-body hidden></p>
              <small data-toast-hint></small>
              <div class="toast-actions">
                <button type="button" class="publish" data-toast-publish>Publish</button>
                <button type="button" data-toast-apply>Not yet</button>
              </div>
            </section>
          </div>
        </section>
      </section>
    </main>

    <dialog class="name-dialog" data-name-dialog aria-labelledby="name-dialog-title">
      <form class="name-form" data-name-form>
        <p class="eyebrow" data-name-kicker></p>
        <h2 id="name-dialog-title" data-name-title></h2>
        <label for="name-dialog-input"><span data-name-label>Tên folder</span></label>
        <input id="name-dialog-input" type="text" maxlength="80" autocomplete="off" spellcheck="false" data-name-input />
        <p class="name-hint" role="status" data-name-hint></p>
        <div class="name-actions">
          <button type="button" data-name-cancel>Huỷ</button>
          <button type="submit" class="primary" data-name-submit>Xác nhận</button>
        </div>
      </form>
    </dialog>

    <script>
            import { bundledLanguagesInfo, codeToHtml } from 'shiki/bundle/full';
      import { parse as parseYaml, stringify as stringifyYaml } from 'yaml';
      import { STUDIO_REPO, STUDIO_TOKEN_KEY, ctfFromFolder } from '../../lib/studio';
      import { slugify } from '../../lib/content/slug';
      import { buildVocabulary, canonicalTag, mergeAiTags, suggestTags, tagKey, type TagSuggestion, type TagTerm } from '../../lib/studio-tags';
      import { geminiSuggestTags } from '../../lib/studio-gemini-tags';
      import type { TagExample } from '../../lib/tag-prompt';
      import { EditorState, Prec, type Extension, type TransactionSpec } from '@codemirror/state';
      import { EditorView, drawSelection, highlightActiveLine, highlightActiveLineGutter, keymap, lineNumbers, type ViewUpdate } from '@codemirror/view';
      import { defaultKeymap, history, historyKeymap, indentLess, indentMore } from '@codemirror/commands';
      import { highlightSelectionMatches, search, searchKeymap } from '@codemirror/search';
      import { type Anchor, escapeHtml, lineToTop, normalizeAnchors, normalizeCallouts, normalizeSpoilers, prepareExtensions, renderBlocks, topToLine } from '../../lib/studio-preview';
      import { codeFenceLanguages, insertIndent, insertLink, pasteLink, toggleMark, wrapSelection } from '../../lib/studio-editor';
      import { reconcileAction } from '../../lib/studio-sync';
      import { LANGUAGE_ALIASES } from '../../config/code-languages';
      import { acceptCompletion, autocompletion } from '@codemirror/autocomplete';
      import { markdown } from '@codemirror/lang-markdown';
      import { languages } from '@codemirror/language-data';
      import { oneDark } from '@codemirror/theme-one-dark';
      import katex from 'katex';
      import 'katex/dist/katex.min.css';

      const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
      const title = $<HTMLInputElement>('[data-title]');
      const folder = $<HTMLInputElement>('[data-folder]');
      const date = $<HTMLInputElement>('[data-date]');
      const ctf = $<HTMLInputElement>('[data-ctf]');
      const category = $<HTMLInputElement>('[data-category]');
      const difficulty = $<HTMLInputElement>('[data-difficulty]');
      const tags = $<HTMLInputElement>('[data-tags]');
      const preview = $('[data-preview]');
      const previewState = $('[data-preview-state]');
      const status = $('[data-status]');
      const libraryStatus = $('[data-library-status]');
      const tokenInput = $<HTMLInputElement>('[data-token]');
      const assetsInput = $<HTMLInputElement>('[data-assets]');

      type Asset = { file: File; name: string; url: string };
      type RepoFile = { path: string; sha: string };
      type LocalDirectoryHandle = FileSystemDirectoryHandle & {
        queryPermission: (options?: { mode?: 'read' | 'readwrite' }) => Promise<PermissionState>;
        requestPermission: (options?: { mode?: 'read' | 'readwrite' }) => Promise<PermissionState>;
      };
      type ListableDirectory = FileSystemDirectoryHandle & { entries: () => AsyncIterableIterator<[string, FileSystemDirectoryHandle | FileSystemFileHandle]> };
      type Draft = { title: string; folder: string; date: string; ctf: string; category: string; difficulty: string; tags: string; source: string; base?: string };
      type MermaidApi = { initialize: (config: Record<string, unknown>) => void; run: (config: { nodes: NodeListOf<Element> }) => Promise<void> };
      let repo = { name: '', branch: 'main' };
      let openFile: RepoFile | undefined;
      let assets: Asset[] = [];
      let renderVersion = 0;
      let localDirectory: LocalDirectoryHandle | undefined;
      let editor!: EditorView;
      let repoFiles: RepoFile[] = [];
      let repoTree: Array<{ path: string; sha: string; type: string }> = [];
      let remoteBlobs: Array<{ path: string; sha: string; type: string }> = [];
      type PendingFolders = { entries: TreeEntry[]; messages: string[] };
      const pendingKey = 'ctf-wu.studio.pending-folders';
      function readPending(): PendingFolders {
        try { return JSON.parse(localStorage.getItem(pendingKey) ?? '') as PendingFolders; } catch { return { entries: [], messages: [] }; }
      }
      function writePending() {
        try { if (pending.messages.length) localStorage.setItem(pendingKey, JSON.stringify(pending)); else localStorage.removeItem(pendingKey); } catch { /* storage unavailable */ }
      }
      let pending: PendingFolders = readPending();
      let localPermission: PermissionState = 'prompt';
      let mermaidReady: Promise<MermaidApi> | undefined;
      let githubConnected = false;
      type SyncMode = 'off' | 'scroll' | 'follow';
      type SyncSide = 'editor' | 'preview';
      type PreviewBlock = { el: HTMLElement; line: number; end: number; top: number; bottom: number };
      const syncModeKey = 'ctf-wu.studio.sync-mode';
      const assetsOpenKey = 'ctf-wu.studio.assets-open';
      const assetMime = 'application/x-studio-asset';
      let syncMode: SyncMode = (() => { try { const saved = localStorage.getItem(syncModeKey); return saved === 'off' || saved === 'scroll' || saved === 'follow' ? saved : 'follow'; } catch { return 'follow'; } })();
      let anchors: Anchor[] = [];
      let previewBlocks: PreviewBlock[] = [];
      /** Dòng nguồn (có phần lẻ) đang nằm ở đỉnh preview: khối neo để giữ vị trí khi render lại hoặc layout đổi. */
      let viewLine = 0;
      const scrollLockUntil: Record<SyncSide, number> = { editor: 0, preview: 0 };
      let syncSide: SyncSide | undefined;
      let syncFrame = 0;
      let layoutFrame = 0;
      let followFrame = 0;
      let skipFollow = false;
      let cursorMovedAt = 0;
      let cursorBlockLine: number | undefined;
      let cursorBlockTimer: ReturnType<typeof setTimeout> | undefined;
      let usageTimer: ReturnType<typeof setTimeout> | undefined;
      let layoutObserver: ResizeObserver | undefined;
      const observedBlocks = new WeakSet<Element>();
      let renderPending: Promise<void> | undefined;
      let tocScroll: (() => void) | undefined;
      const imageSizes = new Map<string, { w: number; h: number }>();
      const highlightCache = new Map<string, string>();
      let activeFolder: string | undefined;
      const treeOpenKey = 'ctf-wu.studio.tree-open';
      const treeOpen = new Set<string>((() => { try { return JSON.parse(localStorage.getItem(treeOpenKey) ?? '[]') as string[]; } catch { return []; } })());
      const saveTreeOpen = () => { try { localStorage.setItem(treeOpenKey, JSON.stringify([...treeOpen])); } catch { /* storage unavailable */ } };
      const selectedFiles = new Set<string>();
      const selectedFolders = new Set<string>();
      let folderSet = new Set<string>();
      let draftTimer: ReturnType<typeof setTimeout> | undefined;
      // Write-up chưa publish nằm trong thư mục posts local. Chỉ file Studio vừa tạo trong phiên này
      // (owned) mới được đổi tên thư mục theo tiêu đề; file mở lại từ đĩa giữ nguyên đường dẫn.
      let localDraftPath: string | undefined;
      let localDraftOwned = false;
      let localOnly: RepoFile[] = [];
      let localWrite: Promise<void> = Promise.resolve();
      const writtenAssets = new Set<Asset>();

      const editorSource = () => editor.state.doc.toString();
      let editorExtensions: Extension[] = [];
      /** Nạp bài mới: báo cho preview/nháp như một lần sửa, rồi dựng lại state để Ctrl+Z không lùi về bài trước. */
      function setEditorSource(source: string) {
        editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: source } });
        editor.setState(EditorState.create({ doc: source, extensions: editorExtensions }));
        viewLine = 0;
      }
      const run = (view: EditorView, spec: TransactionSpec | null) => { if (spec) view.dispatch(spec); return Boolean(spec); };
      function initEditor() {
        editorExtensions = [
          lineNumbers(), highlightActiveLineGutter(), highlightActiveLine(), drawSelection(), history(), search({ top: true }), highlightSelectionMatches(),
          EditorView.lineWrapping, oneDark,
          markdown({ codeLanguages: languages }),
          autocompletion({ override: [codeFenceLanguages(bundledLanguagesInfo, LANGUAGE_ALIASES)] }),
          EditorView.inputHandler.of((view, _from, _to, text) => {
            const spec = wrapSelection(view.state, text);
            if (spec) view.dispatch(spec);
            return Boolean(spec);
          }),
          Prec.high(EditorView.domEventHandlers({
            paste: (event, view) => {
              if (!run(view, pasteLink(view.state, event.clipboardData?.getData('text/plain') ?? ''))) return false;
              event.preventDefault();
              return true;
            },
          })),
          Prec.high(keymap.of([
            { key: 'Tab', run: (view) => acceptCompletion(view) || run(view, insertIndent(view.state)) || indentMore(view), shift: indentLess },
            { key: 'Mod-b', run: (view) => run(view, toggleMark(view.state, '**')) },
            { key: 'Mod-i', run: (view) => run(view, toggleMark(view.state, '*')) },
            { key: 'Mod-e', run: (view) => run(view, toggleMark(view.state, '`')) },
            { key: 'Mod-Shift-x', run: (view) => run(view, toggleMark(view.state, '~~')) },
            { key: 'Mod-k', run: (view) => run(view, insertLink(view.state)) },
          ])),
          keymap.of([...defaultKeymap, ...historyKeymap, ...searchKeymap]),
          EditorState.allowMultipleSelections.of(true),
          Prec.high(EditorView.domEventHandlers({
            dragover: (event) => { const types = [...(event.dataTransfer?.types ?? [])]; if (!types.includes('Files') && !types.includes(assetMime)) return false; event.preventDefault(); return true; },
            drop: (event, view) => {
              const pos = view.posAtCoords({ x: event.clientX, y: event.clientY }) ?? view.state.selection.main.head;
              const dropped = assets.find((asset) => asset.name === event.dataTransfer?.getData(assetMime));
              if (dropped) { event.preventDefault(); insertOwnLine(assetMarkdown(dropped), pos); return true; }
              if (!event.dataTransfer?.files.length) return false;
              event.preventDefault(); view.dispatch({ selection: { anchor: pos } }); addFiles(event.dataTransfer.files);
              return true;
            },
          })),
          EditorView.updateListener.of((update) => {
            if (update.docChanged) { scheduleDraft(); scheduleUsage(); void renderPreview().then(scheduleFollow); shiftViewLine(update); }
            if (update.docChanged || update.selectionSet) { cursorMovedAt = performance.now(); if (!update.docChanged) scheduleFollow(); }
          }),
        ];
        editor = new EditorView({ state: EditorState.create({ doc: '', extensions: editorExtensions }), parent: $('[data-editor]') });
        editor.contentDOM.addEventListener('paste', (event) => {
