---
import { CATEGORIES, DIFFICULTIES } from '../../lib/content/constants';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Write-up Studio</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="studio">
      <header class="topbar">
        <div class="brand-actions">
          <button type="button" class="icon-button" data-sidebar-toggle aria-label="Thu gọn thư viện" title="Thu gọn thư viện">☰</button>
          <a class="wordmark" href="/admin/studio/">CTF<span>//</span>WU <small>Studio</small></a>
          <button type="button" class="connection-pill" data-connection title="GitHub chưa kết nối"><i></i><span>GitHub</span></button>
        </div>
        <div class="top-actions">
          <a href="/admin/import/">Import cả giải</a>
          <button type="button" class="publish" data-publish>Publish</button>
        </div>
      </header>

      <aside class="library" aria-label="Thư viện write-up">
        <div class="library-head">
          <div>
            <p class="eyebrow">Write-up library</p>
            <strong data-repo>Đang đọc cấu hình…</strong>
          </div>
          <button type="button" title="Tải lại danh sách" aria-label="Tải lại danh sách" data-reload>↻</button>
        </div>
        <div class="token-box" data-token-box hidden>
          <label for="token">GitHub token</label>
          <input id="token" type="password" autocomplete="off" placeholder="github_pat_…" data-token />
          <button type="button" data-connect>Kết nối</button>
          <p>Token được lưu trong trình duyệt này để Studio publish vào repository.</p>
        </div>
        <button type="button" class="new-file" data-new>+ Bài viết mới</button>
        <nav class="tree" aria-label="Danh sách bài" data-tree>
          <p class="empty-tree">Kết nối GitHub để mở danh sách bài.</p>
        </nav>
      </aside>

      <section class="workspace" aria-label="Soạn write-up">
        <section class="library-home" data-library-home>
          <div class="browser-head">
            <div><p class="eyebrow" data-library-path>Workspace / WU</p><h1 data-library-title>Thư mục write-up</h1></div>
            <div class="browser-actions"><button type="button" class="back-folder" data-folder-back hidden>← Tất cả folder</button><button type="button" class="create-folder" data-new>+ Tạo write-up</button></div>
          </div>
          <div class="folder-grid" data-folder-grid><p class="empty-tree">Kết nối GitHub để tải thư mục.</p></div>
          <section class="folder-posts" data-folder-posts hidden><h2>Bài trong folder</h2><div class="recent-grid" data-folder-files></div></section>
          <section class="recent-posts" data-recent-section><h2>Bài viết gần đây</h2><div class="recent-grid" data-recent-posts></div></section>
        </section>

        <section class="composer" data-composer hidden>
          <div class="editor-tools">
            <button type="button" class="back-library" data-library>← Thư mục</button>
            <strong data-file-label>Write-up mới</strong>
            <span data-save-state>Chưa publish</span>
            <button type="button" data-auto-tags>+ Tự thêm tags</button>
            <button type="button" data-metadata-toggle>Thông tin bài</button>
          </div>

          <details class="metadata" data-metadata>
            <summary>Thông tin bài viết</summary>
            <div class="metadata-fields">
              <label class="title-field"><span>Tiêu đề</span><input type="text" data-title placeholder="Tên challenge" /></label>
              <label><span>Folder</span><input type="text" data-folder value="Dreamhack" placeholder="Dreamhack" /></label>
              <label><span>Ngày</span><input type="date" data-date /></label>
              <label><span>CTF</span><input type="text" data-ctf placeholder="Dreamhack" /></label>
              <label><span>Category</span><select data-category><option value="">Chưa chọn</option>{CATEGORIES.map((c) => <option value={c}>{c}</option>)}</select></label>
              <label><span>Độ khó</span><select data-difficulty><option value="">Chưa chọn</option>{DIFFICULTIES.map((d) => <option value={d}>{d}</option>)}</select></label>
              <label class="tags-field"><span>Tags</span><input type="text" data-tags placeholder="xss, svg, javascript" /></label>
            </div>
          </details>

          <div class="markdown-tools" aria-label="Công cụ Markdown">
            <button type="button" data-markdown="heading">H2</button><button type="button" data-markdown="bold"><b>B</b></button><button type="button" data-markdown="link">Link</button><button type="button" data-markdown="code">Code</button><button type="button" data-markdown="info">Info</button><button type="button" data-markdown="warning">Warning</button><button type="button" data-markdown="footnote">Footnote</button><button type="button" data-markdown="highlight">Highlight</button><button type="button" data-markdown="latex">LaTeX</button><button type="button" data-markdown="mermaid">Mermaid</button><button type="button" data-markdown="sup">Sup</button><button type="button" data-markdown="sub">Sub</button><button type="button" data-markdown="toc">Mục lục</button><button type="button" data-markdown="youtube">YouTube</button><button type="button" data-markdown="task">Task</button><button type="button" data-markdown="quote">Quote</button>
          </div>

          <div class="editor-grid">
            <section class="source-pane">
              <div class="pane-head"><span>Markdown</span><span>Ctrl+V ảnh để chèn</span></div>
              <div class="code-editor" data-editor></div>
              <label class="asset-drop" data-drop>
                <input type="file" multiple data-assets accept="image/*,.svg,.txt,.py,.js,.ts,.zip,.pdf" />
                <span>Thả file hoặc bấm để thêm vào bài</span>
              </label>
              <ul class="assets" data-assets-list></ul>
            </section>
            <div class="resize-handle" data-resize aria-label="Kéo để đổi độ rộng editor" role="separator" aria-orientation="vertical"></div>
            <section class="preview-pane">
              <div class="pane-head"><span>Preview</span><span data-preview-state>Đang chờ nội dung</span></div>
              <article class="preview" data-preview><p class="placeholder">Preview Markdown sẽ hiện ở đây.</p></article>
            </section>
          </div>
          <p class="status" role="status" data-status></p>
        </section>
      </section>
    </main>

    <script>
      import { marked } from 'marked';
      import { codeToHtml } from 'shiki';
      import { parse as parseYaml, stringify as stringifyYaml } from 'yaml';
      import { EditorState } from '@codemirror/state';
      import { EditorView, lineNumbers } from '@codemirror/view';
      import { markdown } from '@codemirror/lang-markdown';
      import { languages } from '@codemirror/language-data';
      import { oneDark } from '@codemirror/theme-one-dark';
      import katex from 'katex';
      import 'katex/dist/katex.min.css';
      // Mermaid's pre-bundled browser build avoids the Vite dependency resolver
      // walking optional language-server modules used only by Mermaid's tooling.
      // @ts-expect-error The package does not publish a declaration for this bundle.
      import mermaid from 'mermaid/dist/mermaid.min.js';

      const $ = <T extends Element = HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
      const title = $<HTMLInputElement>('[data-title]');
      const folder = $<HTMLInputElement>('[data-folder]');
      const date = $<HTMLInputElement>('[data-date]');
      const ctf = $<HTMLInputElement>('[data-ctf]');
      const category = $<HTMLSelectElement>('[data-category]');
      const difficulty = $<HTMLSelectElement>('[data-difficulty]');
      const tags = $<HTMLInputElement>('[data-tags]');
      const preview = $('[data-preview]');
      const previewState = $('[data-preview-state]');
      const status = $('[data-status]');
      const tokenInput = $<HTMLInputElement>('[data-token]');
      const assetsInput = $<HTMLInputElement>('[data-assets]');

      type Asset = { file: File; name: string; url: string };
      type RepoFile = { path: string; sha: string };
      type Draft = { title: string; folder: string; date: string; ctf: string; category: string; difficulty: string; tags: string; source: string };
      let repo = { name: '', branch: 'main' };
      let openFile: RepoFile | undefined;
      let assets: Asset[] = [];
      let renderVersion = 0;
      let localDirectory: FileSystemDirectoryHandle | undefined;
      let editor: EditorView;
      let repoFiles: RepoFile[] = [];
      let repoTree: Array<{ path: string; sha: string; type: string }> = [];
      let activeFolder: string | undefined;
      let selectedFiles = new Set<string>();
      let selectedFolders = new Set<string>();
      let draftTimer: ReturnType<typeof setTimeout> | undefined;

      const editorSource = () => editor.state.doc.toString();
      function setEditorSource(source: string) {
        editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: source } });
      }
      function initEditor() {
        editor = new EditorView({
          state: EditorState.create({
            doc: '',
            extensions: [
              lineNumbers(), EditorView.lineWrapping, oneDark,
              markdown({ codeLanguages: languages }),
              EditorView.updateListener.of((update) => { if (update.docChanged) { void renderPreview(); scheduleDraft(); } }),
            ],
          }),
          parent: $('[data-editor]'),
        });
        mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'strict' });
        editor.contentDOM.addEventListener('paste', (event) => {
          const images = [...(event.clipboardData?.items ?? [])].filter((item) => item.type.startsWith('image/')).map((item) => item.getAsFile()).filter((file): file is File => Boolean(file));
          if (images.length) { event.preventDefault(); addFiles(images); }
        });
      }

      const draftKey = () => `ctf-wu.studio.draft.${openFile?.path ?? `new:${relativeFolder()}`}`;
      function scheduleDraft() { clearTimeout(draftTimer); draftTimer = setTimeout(saveDraft, 450); }
      function saveDraft() {
        if (!$('[data-composer]').hasAttribute('hidden') && (title.value.trim() || editorSource().trim())) {
          const draft: Draft = { title: title.value, folder: folder.value, date: date.value, ctf: ctf.value, category: category.value, difficulty: difficulty.value, tags: tags.value, source: editorSource() };
          localStorage.setItem(draftKey(), JSON.stringify(draft));
          $('[data-save-state]').textContent = 'Nháp đã lưu cục bộ';
        }
      }
      function restoreDraft() {
        try {
          const value = localStorage.getItem(draftKey());
          if (!value) return false;
          const draft = JSON.parse(value) as Draft;
          title.value = draft.title; folder.value = draft.folder; date.value = draft.date; ctf.value = draft.ctf;
          category.value = draft.category; difficulty.value = draft.difficulty; tags.value = draft.tags; setEditorSource(draft.source);
          $('[data-save-state]').textContent = 'Đã khôi phục nháp cục bộ';
          return true;
        } catch { return false; }
      }
      function removeDraft() { localStorage.removeItem(draftKey()); }

      function storedToken(): string {
        try {
          const user = JSON.parse(localStorage.getItem('sveltia-cms.user') ?? 'null') as { token?: unknown } | null;
          return typeof user?.token === 'string' ? user.token : localStorage.getItem('ctf-wu.studio-token') ?? '';
        } catch { return ''; }
      }
      const token = () => storedToken() || tokenInput.value.trim();
      function updateConnection() {
        const connected = Boolean(token());
        const pill = $('[data-connection]');
        pill.dataset.connected = String(connected);
        pill.title = connected ? 'GitHub đã kết nối' : 'GitHub chưa kết nối';
        pill.querySelector('span')!.textContent = connected ? 'Đã kết nối' : 'GitHub';
      }
      function setStatus(message: string, kind: 'info' | 'error' | 'ok' = 'info') {
        status.textContent = message;
        status.dataset.kind = kind;
      }
      async function api<T>(path: string, init: RequestInit = {}): Promise<T> {
        const response = await fetch(`https://api.github.com/repos/${repo.name}${path}`, {
          ...init,
          headers: {
            Accept: 'application/vnd.github+json', Authorization: `Bearer ${token()}`,
            'X-GitHub-Api-Version': '2022-11-28', ...(init.body ? { 'Content-Type': 'application/json' } : {}),
          },
        });
        if (!response.ok) {
          const data = await response.json().catch(() => ({})) as { message?: string };
          throw new Error(`GitHub ${response.status}: ${data.message ?? response.statusText}`);
        }
        return response.json() as Promise<T>;
      }
      const slugify = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim()
        .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      const decode = (text: string) => new TextDecoder().decode(Uint8Array.from(atob(text.replace(/\n/g, '')), (c) => c.charCodeAt(0)));
      const postRoot = 'src/content/posts';
      const relativeFolder = () => folder.value.trim().replace(/^\/+|\/+$/g, '') || 'uncategorized';
      const currentPath = () => openFile?.path ?? `${postRoot}/${relativeFolder()}/${slugify(title.value || 'untitled')}/index.md`;
      const articleDirectory = () => currentPath().replace(/\/[^/]+$/, '');
      const assetUrl = (name: string) => {
        const localAsset = assets.find((asset) => asset.name === name);
        if (localAsset) return localAsset.url;
        if (!openFile || !repo.name || name.includes('..')) return undefined;
        const path = `${articleDirectory()}/${name}`.split('/').map(encodeURIComponent).join('/');
        return `https://raw.githubusercontent.com/${repo.name}/${encodeURIComponent(repo.branch)}/${path}`;
      };
      function encodeBinary(bytes: Uint8Array) {
        let binary = '';
        for (let offset = 0; offset < bytes.length; offset += 0x8000) binary += String.fromCharCode(...bytes.subarray(offset, offset + 0x8000));
        return btoa(binary);
      }

      function parsePost(source: string) {
        const match = /^---\r?\n([\s\S]*?)\r?\n---\r?\n?/.exec(source);
        const fields = match ? (parseYaml(match[1]) ?? {}) as Record<string, unknown> : {};
        return { fields, body: source.slice(match?.[0].length ?? 0) };
      }
      function composePost() {
        const fields: Record<string, unknown> = { title: title.value.trim() || 'Untitled' };
        if (date.value) fields.date = date.value;
        if (ctf.value.trim()) fields.ctf = ctf.value.trim();
        if (category.value) fields.category = category.value;
        if (difficulty.value) fields.difficulty = difficulty.value;
        const tagList = tags.value.split(',').map((tag) => tag.trim()).filter(Boolean);
        if (tagList.length) fields.tags = tagList;
        return `---\n${stringifyYaml(fields)}---\n\n${editorSource().trim()}\n`;
      }
      function populate(source: string) {
        const post = parsePost(source);
        title.value = typeof post.fields.title === 'string' ? post.fields.title : '';
        date.value = typeof post.fields.date === 'string' ? post.fields.date.slice(0, 10) : '';
        ctf.value = typeof post.fields.ctf === 'string' ? post.fields.ctf : folder.value;
        category.value = typeof post.fields.category === 'string' ? post.fields.category : '';
        difficulty.value = typeof post.fields.difficulty === 'string' ? post.fields.difficulty : '';
        tags.value = Array.isArray(post.fields.tags) ? post.fields.tags.join(', ') : typeof post.fields.tags === 'string' ? post.fields.tags : '';
        setEditorSource(post.body.trim());
        void renderPreview();
      }
      function resetEditor() {
        openFile = undefined;
        assets.forEach((asset) => URL.revokeObjectURL(asset.url)); assets = [];
        title.value = ''; date.value = new Date().toISOString().slice(0, 10); ctf.value = folder.value;
        category.value = ''; difficulty.value = ''; tags.value = ''; setEditorSource('');
        $('[data-file-label]').textContent = 'Write-up mới';
        $('[data-save-state]').textContent = 'Chưa publish';
        renderAssets(); void renderPreview();
      }
      async function loadConfig() {
        const config = parseYaml(await (await fetch('/admin/config.yml')).text()) as { backend?: { repo?: string; branch?: string } };
        repo = { name: config.backend?.repo ?? '', branch: config.backend?.branch ?? 'main' };
        $('[data-repo]').textContent = `${repo.name} / ${repo.branch}`;
        $('[data-token-box]').hidden = Boolean(storedToken());
        updateConnection();
        if (token()) void loadTree();
      }
      async function loadTree() {
        if (!token()) { $('[data-token-box]').hidden = false; return; }
        updateConnection();
        const tree = $('[data-tree]'); tree.innerHTML = '<p class="empty-tree">Đang tải write-up…</p>';
        try {
          const ref = await api<{ object: { sha: string } }>(`/git/ref/heads/${encodeURIComponent(repo.branch)}`);
          const data = await api<{ tree: Array<{ path: string; type: string; sha: string }> }>(`/git/trees/${ref.object.sha}?recursive=1`);
          repoTree = data.tree.filter((item) => item.type === 'blob');
          const files = repoTree.filter((item) => item.path.startsWith(`${postRoot}/`) && (item.path.endsWith('/index.md') || /\.md$/.test(item.path)))
            .map((item) => ({ path: item.path, sha: item.sha })).sort((a, b) => a.path.localeCompare(b.path));
          repoFiles = files;
          renderFolderHome(files);
        } catch (error) { tree.innerHTML = ''; setStatus(error instanceof Error ? error.message : String(error), 'error'); }
      }
      async function openPost(file: RepoFile) {
        try {
          setStatus('Đang mở write-up…');
          const content = await api<{ content: string; sha: string }>(`/contents/${file.path.split('/').map(encodeURIComponent).join('/')}?ref=${encodeURIComponent(repo.branch)}`);
          openFile = { path: file.path, sha: content.sha };
          const parts = file.path.replace(`${postRoot}/`, '').split('/');
          folder.value = parts.slice(0, -2).join('/') || 'uncategorized';
          $('[data-file-label]').textContent = file.path.replace(`${postRoot}/`, '');
          $('[data-save-state]').textContent = 'Đã mở từ GitHub';
          populate(decode(content.content));
          if (restoreDraft()) setStatus('Đã khôi phục bản nháp chưa publish.', 'ok'); else setStatus('');
          activeFolder = relativeFolder(); renderSidebar(); showComposer();
        } catch (error) { setStatus(error instanceof Error ? error.message : String(error), 'error'); }
      }
      function showComposer() {
        $('[data-library-home]').setAttribute('hidden', '');
        $('[data-composer]').removeAttribute('hidden');
        setTimeout(() => editor.focus(), 0);
      }
      function showLibrary() {
        $('[data-composer]').setAttribute('hidden', '');
        $('[data-library-home]').removeAttribute('hidden');
      }
      function startNewInFolder(folderName = 'Dreamhack') {
        resetEditor();
        folder.value = folderName;
        ctf.value = folderName.split('/').at(-1) ?? folderName;
        activeFolder = folderName;
        restoreDraft(); renderSidebar();
        showComposer();
        $('[data-metadata]').setAttribute('open', '');
        title.focus();
      }
      const articleName = (file: RepoFile) => file.path.replace(`${postRoot}/`, '').split('/').at(-2) ?? 'Write-up';
      const folderOf = (file: RepoFile) => file.path.replace(`${postRoot}/`, '').split('/').slice(0, -2).join('/') || 'Chưa phân loại';
      function toggleSelectedFile(path: string) { selectedFiles.has(path) ? selectedFiles.delete(path) : selectedFiles.add(path); renderFolderHome(repoFiles); renderSidebar(); }
      function toggleSelectedFolder(folderName: string) {
        const files = repoFiles.filter((file) => folderOf(file) === folderName);
        const allSelected = files.every((file) => selectedFiles.has(file.path));
        files.forEach((file) => allSelected ? selectedFiles.delete(file.path) : selectedFiles.add(file.path));
        selectedFolders.has(folderName) ? selectedFolders.delete(folderName) : selectedFolders.add(folderName);
        renderFolderHome(repoFiles); renderSidebar();
      }
      function makeFileCard(file: RepoFile, className = 'recent-card') {
        const card = document.createElement('article'); card.className = className; card.draggable = true;
        card.innerHTML = `<button type="button" class="selection-checkbox" aria-label="Chọn bài">${selectedFiles.has(file.path) ? '■' : '□'}</button><button type="button" class="file-open"><span>▤</span><strong></strong><small></small></button>`;
        card.querySelector('strong')!.textContent = articleName(file); card.querySelector('small')!.textContent = folderOf(file);
        card.querySelector('.selection-checkbox')!.addEventListener('click', (event) => { event.stopPropagation(); toggleSelectedFile(file.path); });
        card.querySelector('.file-open')!.addEventListener('click', () => void openPost(file));
        card.addEventListener('dragstart', () => { if (!selectedFiles.has(file.path)) { selectedFiles.clear(); selectedFiles.add(file.path); } });
        return card;
      }
      function renderSidebar() {
        const tree = $('[data-tree]');
        const scope = activeFolder ? repoFiles.filter((file) => folderOf(file) === activeFolder) : [];
        if (!activeFolder) { tree.innerHTML = '<p class="empty-tree">Mở một folder hoặc một bài để xem các bài cùng folder.</p>'; return; }
        tree.replaceChildren(...scope.map((file) => {
          const item = document.createElement('div'); item.className = 'tree-file';
          item.innerHTML = `<button type="button" class="selection-checkbox" aria-label="Chọn bài">${selectedFiles.has(file.path) ? '■' : '□'}</button><button type="button" class="tree-open"><span></span><small></small></button>`;
          item.querySelector('span')!.textContent = articleName(file); item.querySelector('small')!.textContent = file.path.replace(`${postRoot}/`, '');
          item.querySelector('.selection-checkbox')!.addEventListener('click', () => toggleSelectedFile(file.path));
          item.querySelector('.tree-open')!.addEventListener('click', () => void openPost(file)); return item;
        }));
      }
      function renderFolderHome(files: RepoFile[]) {
        const folderMap = new Map<string, RepoFile[]>();
        for (const file of files) {
          const parts = file.path.replace(`${postRoot}/`, '').split('/');
          const folderName = parts.length > 2 ? parts.slice(0, -2).join('/') : 'Chưa phân loại';
          folderMap.set(folderName, [...(folderMap.get(folderName) ?? []), file]);
        }
        const grid = $('[data-folder-grid]');
        grid.replaceChildren(...[...folderMap.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([name, folderFiles]) => {
          const card = document.createElement('article'); card.className = 'folder-card'; card.draggable = true;
          card.innerHTML = `<button type="button" class="selection-checkbox" aria-label="Chọn folder">${selectedFolders.has(name) ? '■' : '□'}</button><button type="button" class="folder-open"><span class="folder-icon">▱</span><strong></strong><small>${folderFiles.length} bài viết</small></button>`;
          card.querySelector('strong')!.textContent = name;
          card.querySelector('.selection-checkbox')!.addEventListener('click', (event) => { event.stopPropagation(); toggleSelectedFolder(name); });
          card.querySelector('.folder-open')!.addEventListener('click', () => { activeFolder = name; renderFolderHome(repoFiles); renderSidebar(); });
          card.addEventListener('dragstart', () => { if (!selectedFolders.has(name)) { selectedFolders.clear(); selectedFolders.add(name); } });
          card.addEventListener('dragover', (event) => { event.preventDefault(); card.dataset.drop = ''; });
          card.addEventListener('dragleave', () => delete card.dataset.drop);
          card.addEventListener('drop', (event) => { event.preventDefault(); delete card.dataset.drop; void moveSelectionTo(name); });
          return card;
        }));
        const folderPosts = $('[data-folder-posts]'); const folderFiles = $('[data-folder-files]');
        const isFolderOpen = Boolean(activeFolder && folderMap.has(activeFolder));
        folderPosts.toggleAttribute('hidden', !isFolderOpen); $('[data-recent-section]').toggleAttribute('hidden', isFolderOpen);
        $('[data-folder-back]').toggleAttribute('hidden', !isFolderOpen);
        $('[data-library-path]').textContent = isFolderOpen ? `Workspace / WU / ${activeFolder}` : 'Workspace / WU';
        $('[data-library-title]').textContent = isFolderOpen ? activeFolder! : 'Thư mục write-up';
        if (isFolderOpen) folderFiles.replaceChildren(...folderMap.get(activeFolder!)!.map((file) => makeFileCard(file, 'folder-file-card')));
        const recent = $('[data-recent-posts]');
        recent.replaceChildren(...files.slice(-8).reverse().map((file) => makeFileCard(file)));
      }
      async function moveSelectionTo(targetFolder: string) {
        const files = repoFiles.filter((file) => selectedFiles.has(file.path)).filter((file) => folderOf(file) !== targetFolder);
        if (!files.length) return setStatus('Chọn ít nhất một bài ở folder khác trước khi kéo thả.', 'info');
        if (!token()) return setStatus('Cần kết nối GitHub để sắp xếp bài.', 'error');
        const conflict = files.find((file) => repoFiles.some((candidate) => folderOf(candidate) === targetFolder && articleName(candidate) === articleName(file)));
        if (conflict) return setStatus(`Folder đích đã có bài trùng tên: ${articleName(conflict)}.`, 'error');
        try {
          setStatus(`Đang chuyển ${files.length} bài vào ${targetFolder}…`);
          const ref = await api<{ object: { sha: string } }>(`/git/ref/heads/${encodeURIComponent(repo.branch)}`);
          const parent = await api<{ tree: { sha: string } }>(`/git/commits/${ref.object.sha}`);
          const entries: Array<{ path: string; mode: string; type: string; sha: string | null }> = [];
          for (const file of files) {
            const oldDirectory = file.path.replace(/\/[^/]+$/, '');
            const newDirectory = `${postRoot}/${targetFolder}/${articleName(file)}`;
            for (const item of repoTree.filter((entry) => entry.path === oldDirectory || entry.path.startsWith(`${oldDirectory}/`))) {
              entries.push({ path: item.path.replace(oldDirectory, newDirectory), mode: '100644', type: 'blob', sha: item.sha });
              entries.push({ path: item.path, mode: '100644', type: 'blob', sha: null });
            }
          }
          const tree = await api<{ sha: string }>('/git/trees', { method: 'POST', body: JSON.stringify({ base_tree: parent.tree.sha, tree: entries }) });
          const commit = await api<{ sha: string }>('/git/commits', { method: 'POST', body: JSON.stringify({ message: `content: chuyển ${files.length} write-up vào ${targetFolder}`, tree: tree.sha, parents: [ref.object.sha] }) });
          await api(`/git/refs/heads/${encodeURIComponent(repo.branch)}`, { method: 'PATCH', body: JSON.stringify({ sha: commit.sha }) });
          selectedFiles.clear(); selectedFolders.clear(); activeFolder = targetFolder;
          setStatus(`Đã chuyển ${files.length} bài vào ${targetFolder}.`, 'ok'); void loadTree();
        } catch (error) { setStatus(error instanceof Error ? error.message : String(error), 'error'); }
      }
      function renderAssets() {
        const list = $('[data-assets-list]');
        list.replaceChildren(...assets.map((asset) => {
          const item = document.createElement('li');
          item.innerHTML = `<span>${asset.name}</span><button type="button" aria-label="Bỏ ${asset.name}">×</button>`;
          item.querySelector('button')!.addEventListener('click', () => {
            URL.revokeObjectURL(asset.url); assets = assets.filter((entry) => entry !== asset); renderAssets(); void renderPreview();
          }); return item;
        }));
      }
      function insertText(text: string) {
        const range = editor.state.selection.main;
        editor.dispatch({ changes: { from: range.from, to: range.to, insert: text }, selection: { anchor: range.from + text.length } });
        editor.focus();
      }
      function insertMarkdown(kind: string) {
        const selected = editor.state.sliceDoc(editor.state.selection.main.from, editor.state.selection.main.to) || 'nội dung';
        const snippets: Record<string, string> = {
          heading: `## ${selected}`,
          bold: `**${selected}**`,
          link: `[${selected}](https://)`,
          code: `\`${selected}\``,
          info: `:::info\n${selected}\n:::`,
          warning: `:::warning\n${selected}\n:::`,
          footnote: `${selected}[^1]\n\n[^1]: Chú thích ở cuối bài.`,
          highlight: `==${selected}==`,
          latex: `$$\n${selected === 'nội dung' ? 'E = mc^2' : selected}\n$$`,
          mermaid: `\`\`\`mermaid\ngraph TD\n  A[Bắt đầu] --> B[Kết thúc]\n\`\`\``,
          sup: `<sup>${selected}</sup>`,
          sub: `<sub>${selected}</sub>`,
          toc: '[TOC]',
          youtube: `[YouTube](https://www.youtube.com/watch?v=VIDEO_ID)`,
          task: `- [ ] ${selected}`,
          quote: `> ${selected}`,
        };
        insertText(snippets[kind] ?? selected);
      }
      function autoTags() {
        const source = `${title.value}\n${editorSource()}`.toLowerCase();
        const rules: Array<[string, string]> = [
          ['sql injection', 'SQL Injection'], ['sqli', 'SQL Injection'], ['cross-site scripting', 'XSS'], ['xss', 'XSS'],
          ['prototype pollution', 'Prototype Pollution'], ['path traversal', 'Path Traversal'], ['jwt', 'JWT'], ['oauth', 'OAuth'],
          ['flask', 'Flask'], ['php', 'PHP'], ['javascript', 'JavaScript'], ['node.js', 'Node.js'], ['python', 'Python'],
          ['webdav', 'WebDAV'], ['ssrf', 'SSRF'], ['ssti', 'SSTI'], ['rce', 'RCE'], ['deserialization', 'Deserialization'],
          ['rsa', 'RSA'], ['aes', 'AES'], ['buffer overflow', 'Buffer Overflow'], ['reverse engineering', 'Reverse Engineering'],
        ];
        const existing = tags.value.split(',').map((tag) => tag.trim()).filter(Boolean);
        const seen = new Set(existing.map((tag) => tag.toLowerCase()));
        const added = rules.filter(([needle]) => source.includes(needle)).map(([, tag]) => tag).filter((tag) => !seen.has(tag.toLowerCase()));
        tags.value = [...existing, ...added].join(', ');
        setStatus(added.length ? `Đã thêm tags: ${added.join(', ')}` : 'Chưa tìm được tag mới từ nội dung.', added.length ? 'ok' : 'info');
      }
      function addFiles(files: FileList | File[]) {
        for (const file of Array.from(files)) {
          const safe = file.name.replace(/[^a-zA-Z0-9._-]+/g, '-');
          const name = assets.some((asset) => asset.name === safe) ? `${Date.now()}-${safe}` : safe;
          assets.push({ file, name, url: URL.createObjectURL(file) });
          if (file.type.startsWith('image/')) insertText(`![${name}](./${name})`);
        }
        renderAssets(); void renderPreview();
      }
      const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      function normalizeCallouts(source: string) {
        return source.replace(/^:::(info|warning|note|tip|danger|success)(?:\s+([^\n]+))?\s*\n([\s\S]*?)^:::\s*$/gim, (_all, kind, heading, content) => {
          const title = heading || kind.charAt(0).toUpperCase() + kind.slice(1).toLowerCase();
          return `> [!${kind.toUpperCase()}] ${title}\n> ${content.trim().replace(/\n/g, '\n> ')}`;
        });
      }
      function decorateCallouts() {
        for (const quote of preview.querySelectorAll('blockquote')) {
          const paragraph = quote.querySelector('p');
          const match = /^\[!(INFO|WARNING|NOTE|TIP|DANGER|SUCCESS)\]\s+([^\n]+)\n?/.exec(paragraph?.textContent ?? '');
          if (!match || !paragraph) continue;
          quote.classList.add('callout', `callout-${match[1].toLowerCase()}`);
          const label = document.createElement('strong'); label.className = 'callout-label'; label.textContent = match[2];
          paragraph.textContent = (paragraph.textContent ?? '').replace(match[0], '');
          quote.prepend(label);
        }
      }
      function renderTableOfContents() {
        const toc = preview.querySelector('[data-toc]');
        if (!toc) return;
        const headings = [...preview.querySelectorAll<HTMLHeadingElement>('h1,h2,h3')];
        const list = document.createElement('ol');
        headings.forEach((heading, index) => {
          const id = `section-${index + 1}-${slugify(heading.textContent ?? '')}`; heading.id = id;
          const item = document.createElement('li'); const link = document.createElement('a'); link.href = `#${id}`; link.textContent = heading.textContent; item.append(link); list.append(item);
        });
        toc.replaceChildren(list);
      }
      function renderMath() {
        for (const element of preview.querySelectorAll<HTMLElement>('[data-latex]')) {
          try { element.innerHTML = katex.renderToString(element.dataset.latex ?? '', { displayMode: element.dataset.display === 'true', throwOnError: false }); } catch { /* leave source visible */ }
        }
      }
      function renderYoutube() {
        for (const link of preview.querySelectorAll<HTMLAnchorElement>('a[href*="youtube.com"],a[href*="youtu.be"]')) {
          const match = /(?:v=|youtu\.be\/)([\w-]{6,})/.exec(link.href); if (!match) continue;
          const frame = document.createElement('iframe'); frame.className = 'youtube-embed'; frame.src = `https://www.youtube-nocookie.com/embed/${match[1]}`; frame.title = 'YouTube video'; frame.loading = 'lazy'; frame.allowFullscreen = true;
          link.replaceWith(frame);
        }
      }
      function prepareExtensions(source: string) {
        const footnotes: string[] = [];
        const withoutDefinitions = source.replace(/^\[\^(\d+)\]:\s*(.+)$/gim, (_all, id, content) => { footnotes[Number(id) - 1] = content; return ''; });
        const withNotes = withoutDefinitions.replace(/\[\^(\d+)\]/g, (_all, id) => `<sup class="footnote-ref"><a href="#footnote-${id}">[${id}]</a></sup>`);
        const withHighlight = withNotes.replace(/==([^=\n]+)==/g, '<mark>$1</mark>');
        const withMath = withHighlight.replace(/\$\$\s*([\s\S]+?)\s*\$\$/g, (_all, expression) => `<span data-latex="${escapeHtml(expression.trim())}" data-display="true"></span>`).replace(/\$([^$\n]+)\$/g, (_all, expression) => `<span data-latex="${escapeHtml(expression.trim())}"></span>`);
        const withToc = withMath.replace(/^\[TOC\]\s*$/gim, '<nav class="auto-toc" data-toc aria-label="Mục lục tự động"></nav>');
        if (!footnotes.length) return withToc;
        return `${withToc}\n\n<section class="footnotes"><hr><ol>${footnotes.map((content, index) => content ? `<li id="footnote-${index + 1}">${content}</li>` : '').join('')}</ol></section>`;
      }
      const languageAlias: Record<string, string> = { js: 'javascript', ts: 'typescript', py: 'python', sh: 'bash', yml: 'yaml', html: 'html', svg: 'xml' };
      async function renderPreview() {
        const version = ++renderVersion;
        const source = prepareExtensions(normalizeCallouts(editorSource())).replace(/\]\(\.\/([^\s)]+)\)/g, (all, name) => assetUrl(name) ? `](${assetUrl(name)})` : all);
        if (!source.trim()) { preview.innerHTML = '<p class="placeholder">Preview Markdown sẽ hiện ở đây.</p>'; previewState.textContent = 'Đang chờ nội dung'; return; }
        previewState.textContent = 'Đang render…';
        preview.innerHTML = marked.parse(source, { gfm: true, breaks: true }) as string;
        decorateCallouts();
        renderTableOfContents(); renderMath(); renderYoutube();
        const codeBlocks = [...preview.querySelectorAll<HTMLElement>('pre > code')];
        await Promise.all(codeBlocks.map(async (code) => {
          const rawLanguage = ([...code.classList].find((name) => name.startsWith('language-'))?.slice(9) || 'text').replace(/!+$/, '').toLowerCase();
          if (rawLanguage === 'mermaid') {
            const diagram = document.createElement('pre'); diagram.className = 'mermaid'; diagram.textContent = code.textContent ?? ''; code.parentElement?.replaceWith(diagram); return;
          }
          const language = languageAlias[rawLanguage] ?? rawLanguage;
          try {
            const html = await codeToHtml(code.textContent ?? '', { lang: language, theme: 'github-dark-default' });
            if (version === renderVersion) code.parentElement?.replaceWith(Object.assign(document.createElement('template'), { innerHTML: html }).content.firstElementChild!);
          } catch {
            code.innerHTML = escapeHtml(code.textContent ?? '');
          }
        }));
        if (version === renderVersion) await mermaid.run({ nodes: preview.querySelectorAll('.mermaid') });
        if (version === renderVersion) previewState.textContent = 'Live preview';
      }
      async function publish() {
        if (!token()) { $('[data-token-box]').hidden = false; return setStatus('Nhập GitHub token trước khi publish.', 'error'); }
        if (!title.value.trim()) return setStatus('Cần nhập tiêu đề.', 'error');
        if (!slugify(title.value)) return setStatus('Tiêu đề chưa tạo được tên folder hợp lệ.', 'error');
        if (!localDirectory && !await chooseLocalFolder()) return;
        const filePath = currentPath();
        try {
          setStatus('Đang tạo commit…');
          const ref = await api<{ object: { sha: string } }>(`/git/ref/heads/${encodeURIComponent(repo.branch)}`);
          const parent = await api<{ tree: { sha: string } }>(`/git/commits/${ref.object.sha}`);
          const blobEntries = await Promise.all(assets.map(async (asset) => {
            const binary = new Uint8Array(await asset.file.arrayBuffer());
            const encoded = encodeBinary(binary);
            const blob = await api<{ sha: string }>('/git/blobs', { method: 'POST', body: JSON.stringify({ content: encoded, encoding: 'base64' }) });
            return { path: `${articleDirectory()}/${asset.name}`, mode: '100644', type: 'blob', sha: blob.sha };
          }));
          const tree = await api<{ sha: string }>('/git/trees', { method: 'POST', body: JSON.stringify({ base_tree: parent.tree.sha, tree: [
            { path: filePath, mode: '100644', type: 'blob', content: composePost() }, ...blobEntries,
          ] }) });
          const commit = await api<{ sha: string; html_url: string }>('/git/commits', { method: 'POST', body: JSON.stringify({ message: `content: ${openFile ? 'sửa' : 'thêm'} "${title.value.trim()}"`, tree: tree.sha, parents: [ref.object.sha] }) });
          await api(`/git/refs/heads/${encodeURIComponent(repo.branch)}`, { method: 'PATCH', body: JSON.stringify({ sha: commit.sha }) });
          removeDraft();
          openFile = { path: filePath, sha: '' }; $('[data-file-label]').textContent = filePath.replace(`${postRoot}/`, '');
          $('[data-save-state]').textContent = 'Đã publish';
          const localSynced = await syncLocal({ quiet: true });
          setStatus(localSynced
            ? 'Đã publish GitHub, đồng bộ folder local và kích hoạt Cloudflare Pages build.'
            : 'Đã publish GitHub. Không thể đồng bộ folder local trong lần này.', localSynced ? 'ok' : 'error');
          void loadTree();
        } catch (error) { setStatus(error instanceof Error ? error.message : String(error), 'error'); }
      }
      async function chooseLocalFolder(): Promise<boolean> {
        type DirectoryPickerWindow = Window & {
          showDirectoryPicker?: (options?: { mode?: 'read' | 'readwrite' }) => Promise<FileSystemDirectoryHandle>;
        };
        const picker = (window as DirectoryPickerWindow).showDirectoryPicker;
        if (!picker) { setStatus('Trình duyệt này không hỗ trợ đồng bộ folder local. Dùng Chrome hoặc Edge desktop.', 'error'); return false; }
        try {
          const selectedDirectory = await picker.call(window, { mode: 'readwrite' });
          localDirectory = selectedDirectory;
          setStatus(`Đã chọn ${selectedDirectory.name}. Publish sẽ đồng bộ bài hiện tại vào đây.`, 'ok');
          return true;
        }
        catch { return false; }
      }
      async function syncLocal({ quiet = false }: { quiet?: boolean } = {}) {
        if (!localDirectory) {
          if (!quiet) await chooseLocalFolder();
          return false;
        }
        try {
          let target = localDirectory;
          for (const part of relativeFolder().split('/')) target = await target.getDirectoryHandle(part, { create: true });
          target = await target.getDirectoryHandle(slugify(title.value || 'untitled'), { create: true });
          const write = async (name: string, data: File | string) => { const handle = await target.getFileHandle(name, { create: true }); const stream = await handle.createWritable(); await stream.write(data); await stream.close(); };
          await write('index.md', composePost()); for (const asset of assets) await write(asset.name, asset.file);
          if (!quiet) setStatus('Đã đồng bộ write-up và file đính kèm vào folder local.', 'ok');
          return true;
        } catch (error) {
          if (!quiet) setStatus(error instanceof Error ? error.message : String(error), 'error');
          return false;
        }
      }
      document.querySelectorAll<HTMLButtonElement>('[data-new]').forEach((button) => button.addEventListener('click', () => startNewInFolder(activeFolder || folder.value || 'Dreamhack')));
      $('[data-reload]').addEventListener('click', () => void loadTree());
      $('[data-connect]').addEventListener('click', () => {
        if (tokenInput.value.trim()) localStorage.setItem('ctf-wu.studio-token', tokenInput.value.trim());
        $('[data-token-box]').hidden = Boolean(token()); updateConnection(); void loadTree();
      });
      $('[data-publish]').addEventListener('click', () => void publish());
      $('[data-library]').addEventListener('click', showLibrary);
      $('[data-folder-back]').addEventListener('click', () => { activeFolder = undefined; renderFolderHome(repoFiles); renderSidebar(); });
      $('[data-auto-tags]').addEventListener('click', autoTags);
      $('[data-metadata-toggle]').addEventListener('click', () => {
        const metadata = $<HTMLDetailsElement>('[data-metadata]'); metadata.open = !metadata.open;
      });
      document.querySelectorAll<HTMLButtonElement>('[data-markdown]').forEach((button) => button.addEventListener('click', () => insertMarkdown(button.dataset.markdown ?? '')));
      $('[data-sidebar-toggle]').addEventListener('click', () => {
        const collapsed = document.querySelector('.studio')!.toggleAttribute('data-sidebar-collapsed');
        localStorage.setItem('ctf-wu.studio-sidebar-collapsed', String(collapsed));
      });
      $('[data-connection]').addEventListener('click', () => { $('[data-token-box]').hidden = !($('[data-token-box]').hidden); });
      [title, folder, date, ctf, category, difficulty, tags].forEach((input) => input.addEventListener('input', () => { void renderPreview(); scheduleDraft(); }));
      assetsInput.addEventListener('change', () => { if (assetsInput.files) addFiles(assetsInput.files); assetsInput.value = ''; });
      const drop = $('[data-drop]');
      drop.addEventListener('dragover', (event) => { event.preventDefault(); drop.dataset.over = ''; });
      drop.addEventListener('dragleave', () => delete drop.dataset.over);
      drop.addEventListener('drop', (event) => { event.preventDefault(); delete drop.dataset.over; if (event.dataTransfer?.files) addFiles(event.dataTransfer.files); });
      $('[data-resize]').addEventListener('pointerdown', (event) => {
        const handle = event.currentTarget as HTMLElement; const grid = document.querySelector<HTMLElement>('.editor-grid')!;
        handle.setPointerCapture(event.pointerId); document.body.dataset.resizing = '';
        const resize = (move: PointerEvent) => { const box = grid.getBoundingClientRect(); const percent = Math.max(30, Math.min(70, ((move.clientX - box.left) / box.width) * 100)); grid.style.gridTemplateColumns = `${percent}% .55rem minmax(0, 1fr)`; };
        const finish = () => { document.body.removeAttribute('data-resizing'); handle.removeEventListener('pointermove', resize); handle.removeEventListener('pointerup', finish); };
        handle.addEventListener('pointermove', resize); handle.addEventListener('pointerup', finish);
      });
      initEditor();
      if (localStorage.getItem('ctf-wu.studio-sidebar-collapsed') === 'true') document.querySelector('.studio')!.setAttribute('data-sidebar-collapsed', '');
      void loadConfig(); resetEditor();
    </script>
  </body>
</html>

