        localStorage.setItem('ctf-wu.studio-sidebar-collapsed', String(collapsed));
      });
      $('[data-connection]').addEventListener('click', () => { $('[data-token-box]').hidden = !($('[data-token-box]').hidden); if (!$('[data-token-box]').hidden) tokenInput.focus(); });
