---
import TermIndex from '../../components/TermIndex.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { getSiteContent } from '../../lib/posts';

const { tags } = await getSiteContent();
const items = [...tags.terms]
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .map((t) => ({ href: `/tags/${t.slug}/`, label: `#${t.name}`, count: t.count }));
---

<AppLayout view="page" title="Tags" description="Toàn bộ tag của các write-up.">
  <TermIndex title="Tags" items={items} />
</AppLayout>
