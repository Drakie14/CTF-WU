---
import AppLayout from '../layouts/AppLayout.astro';
import { SITE, SOCIALS } from '../config/site';
import { CATEGORY_META } from '../lib/categories';
import { getSiteContent } from '../lib/posts';

const { posts, ctfs, tags } = await getSiteContent();

const socials = [
  {
    label: 'GitHub',
    href: SOCIALS.github,
    icon: 'M12 1.5a10.5 10.5 0 0 0-3.3 20.5c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.6-1.4-3.6-1.4-.5-1.2-1.2-1.5-1.2-1.5-1-.7.1-.7.1-.7 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.5 1.1 3.1.9.1-.7.4-1.1.7-1.4-2.3-.3-4.8-1.2-4.8-5.2 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.4.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.4.2 2.5.1 2.8.7.7 1.1 1.7 1.1 2.8 0 4-2.5 4.9-4.8 5.2.4.3.7 1 .7 2v2.9c0 .3.2.6.7.5A10.5 10.5 0 0 0 12 1.5Z',
  },
  {
    label: 'Discord',
    href: SOCIALS.discord,
    icon: 'M19.6 5.3A18 18 0 0 0 15.2 4l-.6 1.1a16.6 16.6 0 0 0-5.2 0L8.8 4a18 18 0 0 0-4.4 1.3C1.6 9.5.9 13.6 1.2 17.6A18 18 0 0 0 6.6 20.3l1.1-1.8c-.6-.2-1.2-.5-1.8-.9l.4-.3a12.9 12.9 0 0 0 11.2 0l.4.3c-.6.4-1.2.7-1.8.9l1.1 1.8a18 18 0 0 0 5.4-2.7c.4-4.6-.7-8.7-3.1-12.3ZM8.7 15.2c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2Zm6.6 0c-1.1 0-2-1-2-2.2s.9-2.2 2-2.2 2 1 2 2.2-.9 2.2-2 2.2Z',
  },
  {
    label: 'Facebook',
    href: SOCIALS.facebook,
    icon: 'M22.5 12a10.5 10.5 0 1 0-12.1 10.4v-7.3H7.7V12h2.7V9.7c0-2.6 1.6-4.1 4-4.1 1.1 0 2.3.2 2.3.2v2.6h-1.3c-1.3 0-1.7.8-1.7 1.6V12h2.9l-.5 3.1h-2.4v7.3A10.5 10.5 0 0 0 22.5 12Z',
  },
].filter((s) => s.href);
---

<AppLayout view="page" title="About" description={`Giới thiệu về ${SITE.name}`}>
  <article class="page">
    <h1>About</h1>
    <p class="owner">Write-up của <strong>{SITE.author}</strong></p>
    <p class="school">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3 1 9l11 6 9-4.9V17h2V9L12 3Zm-6.8 9.6V16c0 1.9 3 3.5 6.8 3.5s6.8-1.6 6.8-3.5v-3.4L12 16.3l-6.8-3.7Z" />
      </svg>
      <a href={SITE.schoolUrl} target="_blank" rel="noopener noreferrer">{SITE.school}</a>
    </p>
    <blockquote class="motto">
      <span class="stars" aria-hidden="true">
        <svg class="star" viewBox="0 0 24 24">
          <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9L12 2.5Z" />
        </svg>
        {[1, 2, 3, 4, 5].map((i) => (
          <svg class={`sparkle s${i}`} viewBox="0 0 24 24">
            <path d="M12 0c.6 7.2 4.8 11.4 12 12-7.2.6-11.4 4.8-12 12-.6-7.2-4.8-11.4-12-12 7.2-.6 11.4-4.8 12-12Z" />
          </svg>
        ))}
      </span>
      <span class="motto-text">{SITE.motto}</span>
    </blockquote>
    {
      socials.length > 0 && (
        <ul class="socials" aria-label="Mạng xã hội">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer me">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d={s.icon} />
                </svg>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <div class="prose">
      <p>{SITE.description}</p>
      <p>
        Hiện có <strong>{posts.length}</strong> write-up từ <strong>{ctfs.terms.length}</strong> giải CTF với{' '}
        <strong>{tags.terms.length}</strong> tag. Mọi write-up chỉ được đăng sau khi giải đã kết thúc.
      </p>
      <h2>Category</h2>
      <ul class="cats">
        {
          Object.entries(CATEGORY_META).map(([key, meta]) => (
            <li>
              <a href={`/category/${key}/`} style={`--c:${meta.color}`}>
                {meta.label}
              </a>
            </li>
          ))
        }
      </ul>
      <h2>Liên kết</h2>
      <ul>
        <li><a href="/archive/">Archive</a>: danh sách toàn bộ bài viết</li>
        <li><a href="/search/">Search</a>: tìm kiếm write-up</li>
      </ul>
    </div>
  </article>
</AppLayout>

<style>
  .page {
    max-width: 46rem;
    margin: 0 auto;
    padding: 2.5rem clamp(1.25rem, 3vw, 2.75rem) 4rem;
  }
  h1 {
    margin: 0 0 0.4rem;
    font-size: 2rem;
    font-weight: 600;
  }
  .owner {
    margin: 0 0 1rem;
    color: var(--text-soft);
  }
  .owner strong {
    color: var(--accent);
  }
  .school {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  .school svg {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }
  .school a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dashed color-mix(in srgb, currentColor 45%, transparent);
  }
  .school a:hover,
  .school a:focus-visible {
    color: var(--accent);
  }
  .motto {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.5rem;
    padding: 0.55rem 1.1rem 0.55rem 0.85rem;
    border: 1px solid color-mix(in srgb, #f5c542 35%, transparent);
    border-radius: 999px;
    background: linear-gradient(90deg, color-mix(in srgb, #f5c542 14%, transparent), color-mix(in srgb, var(--accent) 10%, transparent));
    font-style: italic;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  /* Cụm sao lấp lánh: sao chính "thở" nhẹ, các sao 4 cánh lần lượt hiện ra rồi biến mất. */
  .stars {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
  }
  .stars svg {
    position: absolute;
    fill: #f5c542;
  }
  .star {
    inset: 0.35rem;
    width: 1.3rem;
    height: 1.3rem;
    filter: drop-shadow(0 0 6px color-mix(in srgb, #f5c542 60%, transparent));
    animation: glow 2.4s ease-in-out infinite;
  }
  .sparkle {
    width: 0.6rem;
    height: 0.6rem;
    transform: scale(0);
    filter: drop-shadow(0 0 3px #fff3c4);
    animation: twinkle 2.4s ease-in-out infinite;
  }
  .s1 { top: -0.35rem; left: -0.3rem; }
  .s2 { top: -0.45rem; right: -0.45rem; width: 0.5rem; height: 0.5rem; animation-delay: 0.5s; }
  .s3 { bottom: -0.3rem; right: -0.35rem; animation-delay: 1s; }
  .s4 { bottom: -0.25rem; left: -0.5rem; width: 0.45rem; height: 0.45rem; animation-delay: 1.5s; }
  .s5 { top: 0.75rem; right: -0.85rem; width: 0.4rem; height: 0.4rem; animation-delay: 1.9s; }
  .motto-text {
    background: linear-gradient(90deg, #f5c542, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes glow {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.12) rotate(10deg); }
  }
  @keyframes twinkle {
    0%, 100% { transform: scale(0) rotate(0deg); opacity: 0; }
    20% { transform: scale(1) rotate(45deg); opacity: 1; }
    40% { transform: scale(0) rotate(90deg); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .star { animation: none; }
    .sparkle { animation: none; transform: scale(0.8); opacity: 0.7; }
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--panel-border);
    border-radius: 0.6rem;
    background: var(--panel-2);
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .socials a:hover,
  .socials a:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .socials svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .cats li {
    margin: 0;
  }
  .cats a {
    display: inline-block;
    padding: 0.2rem 0.8rem;
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--c) 16%, transparent);
    color: var(--c);
    text-decoration: none;
  }
</style>
