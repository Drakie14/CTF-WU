---
import FilterPanel from '../../components/FilterPanel.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { CATEGORY_META } from '../../lib/categories';
import { CATEGORIES } from '../../lib/content/constants';
import { getSiteContent, type Post } from '../../lib/posts';

/** `/category/<name>` — mọi category hợp lệ (danh sách cố định theo mục 9). */
export async function getStaticPaths() {
  const { posts } = await getSiteContent();
  return CATEGORIES.map((c) => ({
    params: { name: c },
    props: { label: CATEGORY_META[c].label, posts: posts.filter((p) => p.data.category === c) },
  }));
}

interface Props {
  label: string;
  posts: Post[];
}
const { label, posts } = Astro.props;
const { tags } = await getSiteContent();
const description = posts.length ? `${posts.length} write-up thuộc category ${label}.` : `Chưa có write-up nào thuộc category ${label}.`;
---

<AppLayout
  view="filter"
  title={`Category: ${label}`}
  description={description}
  noindex={posts.length === 0}
  sidebarPosts={posts}
  filter={{ kind: 'Category', label, key: `cat-${Astro.params.name}` }}
>
  <FilterPanel kind="Category" label={label} description={description} posts={posts} tags={tags} />
</AppLayout>
