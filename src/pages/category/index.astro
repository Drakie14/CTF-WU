---
import TermIndex from '../../components/TermIndex.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { CATEGORY_META } from '../../lib/categories';
import { CATEGORIES } from '../../lib/content/constants';
import { getSiteContent } from '../../lib/posts';

const { posts } = await getSiteContent();
const items = CATEGORIES.map((c) => ({
  href: `/category/${c}/`,
  label: CATEGORY_META[c].label,
  count: posts.filter((p) => p.data.category === c).length,
}));
---

<AppLayout view="page" title="Categories" description="Write-up theo category.">
  <TermIndex title="Categories" items={items} />
</AppLayout>
