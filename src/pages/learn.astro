---
import AppLayout from '../layouts/AppLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getSiteContent } from '../lib/posts';
import { TRACKS, learningStages } from '../lib/learning';
const { posts } = await getSiteContent();
---
<AppLayout view="page" title="Lộ trình học" description="Đọc write-up theo kỹ thuật: XSS, injection và access control.">
  <article class="learning">
    <header><h1>Lộ trình học</h1><p>Chọn một kỹ thuật và đi từ các bài dễ tới những tình huống phức tạp hơn. Mỗi chặng gom các write-up theo tag; bài chưa có độ khó nằm cuối chặng.</p></header>
    <nav aria-label="Chọn lộ trình">{TRACKS.map(track=><a href={`#${track.id}`}>{track.title}</a>)}</nav>
    {TRACKS.map(track=><section id={track.id}><h2>{track.title}</h2><p>{track.description}</p>{learningStages(track,posts).map(stage=><section class="stage"><h3>{stage.title}</h3>{stage.posts.length?<ul>{stage.posts.map(post=><PostRow post={post}/>)}</ul>:<p class="empty">Chặng này sẽ được bổ sung khi có write-up phù hợp.</p>}</section>)}</section>)}
  </article>
</AppLayout>
<style>
.learning{max-width:48rem;margin:auto;padding:2.5rem clamp(1rem,3vw,2.75rem) 4rem}.learning h1{font-size:2rem;margin:0 0 1rem}.learning p{color:var(--text-soft);line-height:1.8}.learning nav{display:flex;flex-wrap:wrap;gap:1.25rem;padding:1rem 0}.learning nav a{color:var(--accent);text-underline-offset:.3em}.learning>section{margin-top:3rem;scroll-margin-top:4rem}.learning h2{font-size:1.5rem}.learning h3{font-size:1rem;color:var(--text-soft);font-weight:500}.stage{margin-top:1.5rem}.stage ul{list-style:none;margin:0;padding:0}.empty{font-size:.9rem}
</style>
