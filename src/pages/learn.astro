---
import AppLayout from '../layouts/AppLayout.astro';
import { getSiteContent, postUrl } from '../lib/posts';
import { TRACKS, learningStages, journeyLayout } from '../lib/learning';
const { posts } = await getSiteContent();
const routes = TRACKS.map(track => {
  const stages = learningStages(track, posts);
  return { ...track, stages, ...journeyLayout(stages.length), count: new Set(stages.flatMap(s => s.posts.map(p => p.id))).size };
});
---
<AppLayout view="page" title="Lộ trình học" description="Khám phá các kỹ thuật web qua bản đồ XSS, injection và access control.">
  <article class="learning" data-learning>
    <header class="learning-head">
      <h1>Lộ trình học</h1>
      <p>Chọn một kỹ thuật và khám phá từng điểm dừng.</p>
    </header>
    <nav class="track-nav" aria-label="Chọn lộ trình">
      {routes.map((track, i) => <a href={`#${track.id}`} data-track-tab={track.id} aria-controls={track.id} aria-current={i === 0 ? 'page' : undefined}>{track.title}</a>)}
    </nav>
    {routes.map(track => (
      <section class="track" id={track.id} aria-labelledby={`${track.id}-title`} data-track-panel>
        <div class="journey-head">
          <div><h2 id={`${track.id}-title`}>{track.title}</h2><p>{track.description}</p></div>
          <span class="journey-count">{track.stages.length} chặng <span aria-hidden="true">/</span> {track.count} bài</span>
        </div>
        <div class="road-scene">
          <p class="map-hint"><span class="mouse-hint">Di chuột vào điểm dừng để chọn bài</span><span class="touch-hint">Chạm vào điểm dừng để chọn bài</span></p>
          <div class="road-map" style={`height:${track.height}px`}>
            <svg class="road-drawing" viewBox={`0 0 600 ${track.height}`} preserveAspectRatio="none" aria-hidden="true">
              <path class="road-edge" d={track.path} />
              <path class="road-surface" d={track.path} />
              <path class="road-lane" d={track.path} />
            </svg>
            <ol class="stages" aria-label={`Các chặng ${track.title}`}>
              {track.stages.map((stage, i) => (
                <li class="stage" style={`left:${track.points[i].x / 6}%;top:${track.points[i].y}px`}>
                  <button type="button" class="road-stop" id={stage.id} data-learning-stop data-track={track.id} popovertarget={`${stage.id}-panel`} aria-haspopup="dialog" aria-controls={`${stage.id}-panel`}>
                    <span class="stop-marker"><svg viewBox="0 0 24 24" aria-hidden="true"><use href={`/icons/learning.svg#${stage.icon}`} /></svg><span class="stop-index" aria-hidden="true">{i + 1}</span></span>
                    <span class="stop-label"><span class="stop-title">{stage.title}</span><span class="stop-count">{stage.posts.length} bài</span></span>
                  </button>
                  <div class="stop-popover" id={`${stage.id}-panel`} popover="auto" role="dialog" aria-labelledby={`${stage.id}-heading`}>
                    <div class="popover-heading"><h3 id={`${stage.id}-heading`}>{stage.title}</h3><button class="popover-close" type="button" popovertarget={`${stage.id}-panel`} popovertargetaction="hide" aria-label="Đóng danh sách bài">×</button></div>
                    <p class="prerequisite">{stage.prerequisite}</p>
                    {stage.posts.length ? (
                      <ul class="lesson-list">{stage.posts.map(post => <li><a class="lesson-link" data-lesson href={postUrl(post)}><span class="lesson-title">{post.data.title}</span><span class="lesson-meta">{post.data.ctf}{post.data.difficulty && <> · {post.data.difficulty}</>}</span><span class="lesson-arrow" aria-hidden="true">↗</span></a></li>)}</ul>
                    ) : <p class="empty">Chặng này chưa có bài. Bạn có thể khám phá các điểm dừng khác.</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
        <p class="track-note">Một bài có thể xuất hiện ở nhiều chặng nếu giải thích nhiều kỹ thuật.</p>
      </section>
    ))}
  </article>
</AppLayout>
<script>
  import '../scripts/learning';
</script>
<style>
  .learning { box-sizing: border-box; max-width: 70rem; margin: auto; padding: 2.25rem clamp(1rem, 3vw, 2.5rem) 3rem; }
  .learning h1 { margin: 0; font-size: clamp(1.6rem, 2.5vw, 2rem); font-weight: 600; }
  .learning-head p { margin: 0.6rem 0 0; font-size: 0.95rem; color: var(--text-soft); }
  .track-nav { display: flex; gap: 0.3rem; border-bottom: 1px solid var(--panel-border); margin: 1.25rem 0 1.5rem; }
  .track-nav a { padding: 0.8rem 0.9rem; border-bottom: 2px solid transparent; color: var(--muted); font-size: 0.9rem; text-decoration: none; white-space: nowrap; }
  .track-nav a:hover { color: var(--text); }
  .track-nav a[aria-current='page'] { border-bottom-color: var(--accent); color: var(--accent); }
  .track { scroll-margin-top: 4rem; }
  .track + .track:not([hidden]) { margin-top: 2rem; }
  .journey-head { display: flex; align-items: flex-start; gap: 1rem; justify-content: space-between; margin-bottom: 1rem; }
  .journey-head h2 { margin: 0; font-size: 1.15rem; font-weight: 600; }
  .journey-head p { max-width: 48ch; margin: 0.4rem 0 0; color: var(--text-soft); font-size: 0.85rem; line-height: 1.7; }
  .journey-count { flex: none; padding-top: 0.2rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); white-space: nowrap; }
  .road-scene { padding: 1rem 1rem 0; border: 1px solid var(--panel-border); border-radius: 1rem; background: radial-gradient(ellipse at 50% 0%, rgb(244 114 182 / 0.05), transparent 65%), var(--panel); }
  .map-hint { margin: 0 0 0.7rem; text-align: center; color: var(--muted); font-size: 0.75rem; }
  .touch-hint { display: none; }
  .road-map { position: relative; width: min(100%, 50rem); margin: auto; }
  .road-drawing { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .road-drawing path { fill: none; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .road-edge { stroke: color-mix(in srgb, var(--accent) 13%, var(--panel-border)); stroke-width: 36px; }
  .road-surface { stroke: var(--panel-2); stroke-width: 30px; }
  .road-lane { stroke: color-mix(in srgb, var(--accent) 65%, var(--muted)); stroke-width: 1.5px; stroke-dasharray: 5 11; }
  .stages { list-style: none; margin: 0; padding: 0; }
  .stage { position: absolute; transform: translate(-50%, -50%); }
  .road-stop { display: block; position: relative; width: 3.5rem; height: 3.5rem; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--text); font: inherit; scroll-margin-block: 5rem 8rem; }
  .stop-marker { display: grid; place-items: center; width: 100%; height: 100%; box-sizing: border-box; border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--panel-border)); border-radius: 50%; background: #302735; box-shadow: 0 5px 0 #201b27, inset 0 1px 0 rgb(255 255 255 / 0.08); }
  .stop-marker svg { width: 1.5rem; height: 1.5rem; }
  .stop-index { position: absolute; top: -0.25rem; right: -0.25rem; display: grid; place-items: center; width: 1.1rem; height: 1.1rem; border: 1px solid var(--panel-border); border-radius: 50%; background: var(--panel); color: var(--muted); font: 0.65rem var(--font-mono); }
  .stop-label { position: absolute; top: calc(100% + 0.85rem); left: 50%; transform: translateX(-50%); width: clamp(5.5rem, 12vw, 9rem); text-align: center; }
  .stop-title { display: block; font-size: 0.82rem; font-weight: 500; line-height: 1.5; }
  .stop-count { display: block; margin-top: 0.2rem; color: var(--muted); font-size: 0.7rem; }
  .road-stop:hover .stop-marker, .road-stop[aria-expanded='true'] .stop-marker, .road-stop:focus-visible .stop-marker { background: var(--accent); color: #1a0b14; border-color: var(--accent); box-shadow: 0 5px 0 #783554, inset 0 1px 0 rgb(255 255 255 / 0.22); }
  .road-stop:hover .stop-title, .road-stop[aria-expanded='true'] .stop-title { color: var(--accent); }
  .track-note { margin: 0.85rem 0 0; color: var(--muted); font-size: 0.72rem; line-height: 1.6; }
  /* Popover ở top layer để không bị khung nội dung cuộn cắt mất. */
  .stop-popover { box-sizing: border-box; position: fixed; inset: 0; margin: auto; width: min(21rem, calc(100vw - 1.5rem)); height: fit-content; max-height: calc(100dvh - 2rem); padding: 1rem; overflow: visible; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--panel-border)); border-radius: 0.85rem; background: #25212c; color: var(--text); box-shadow: 0 12px 36px rgb(10 4 20 / 0.4); }
  /* Vùng vô hình nối khoảng hở để chuột đi từ điểm dừng sang cửa sổ. */
  .stop-popover::before { content: ''; position: absolute; inset: -12px; z-index: -1; }
  .popover-heading { display: flex; align-items: center; gap: 0.75rem; justify-content: space-between; }
  .popover-heading h3 { margin: 0; font-size: 1rem; font-weight: 600; }
  .popover-close { flex: none; width: 2rem; height: 2rem; padding: 0; border: 0; border-radius: 0.4rem; background: var(--panel-2); color: var(--text-soft); font: 1.4rem var(--font-sans); }
  .popover-close:hover { color: var(--accent); }
  .prerequisite { margin: 0.6rem 0 0.8rem; color: var(--text-soft); font-size: 0.8rem; line-height: 1.7; }
  .lesson-list { list-style: none; margin: 0; padding: 0; max-height: min(17rem, 42dvh); overflow-y: auto; overscroll-behavior: contain; }
  .lesson-list li + li { border-top: 1px solid var(--panel-border); }
  .lesson-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem 0.6rem; padding: 0.75rem 0.4rem; border-radius: 0.4rem; text-decoration: none; }
  .lesson-link:hover, .lesson-link:focus-visible { background: rgb(244 114 182 / 0.08); }
  .lesson-title { font-size: 0.85rem; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
  .lesson-meta { grid-column: 1; color: var(--muted); font-size: 0.7rem; line-height: 1.5; }
  .lesson-arrow { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--accent); }
  .empty { font-size: 0.85rem; line-height: 1.6; color: var(--text-soft); }
  @media (prefers-reduced-motion: no-preference) {
    .stop-marker { transition: transform 0.18s ease, background-color 0.18s ease; }
    .road-stop:hover .stop-marker, .road-stop[aria-expanded='true'] .stop-marker { transform: translateY(-2px); }
    .stop-popover:popover-open { animation: reveal-card 0.14s ease-out; }
    @keyframes reveal-card { from { opacity: 0; transform: translateY(5px); } }
  }
  @media (max-width: 767.98px) {
    .learning { padding: 1.5rem 1rem 3rem; }
    .track-nav a { padding: 0.75rem 0.6rem; font-size: 0.8rem; }
    .journey-head { flex-direction: column; gap: 0.5rem; }
    .journey-count { font-size: 0.7rem; }
    .road-scene { padding-inline: 0.75rem; }
    .road-stop { width: 3rem; height: 3rem; }
    .stop-marker svg { width: 1.3rem; height: 1.3rem; }
    .stop-label { width: 5.5rem; }
    .stop-title { font-size: 0.78rem; }
    .map-hint { font-size: 0.7rem; }
  }
  @media (hover: none), (pointer: coarse) { .mouse-hint { display: none; } .touch-hint { display: inline; } }
</style>
