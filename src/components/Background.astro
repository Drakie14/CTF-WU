---
/**
 * Nền low-poly (`/bg.svg`, sinh lúc build) + tối đa 15 hạt bằng CSS (mục 45).
 * Hạt chỉ animate transform/opacity và bị tắt khi prefers-reduced-motion.
 */
const PARTICLES = [
  [8, 22, 6, 16, 0, 30],
  [18, 70, 5, 19, -4, -20],
  [27, 40, 7, 14, -8, 25],
  [36, 85, 4, 21, -2, 40],
  [44, 12, 6, 17, -11, -30],
  [53, 58, 5, 15, -6, 20],
  [61, 30, 8, 22, -14, 35],
  [70, 78, 5, 18, -3, -25],
  [78, 18, 6, 16, -9, 30],
  [86, 50, 4, 20, -12, -15],
  [92, 88, 7, 15, -5, 20],
  [64, 92, 5, 19, -16, -35],
] as const;
---

<div class="bg-layer" aria-hidden="true" transition:persist="bg" style="background-image:url(/bg.svg)"></div>
<div class="particles" aria-hidden="true" transition:persist="particles">
  {
    PARTICLES.map(([x, y, s, d, delay, dx]) => (
      <span style={`--x:${x}%;--y:${y}%;--s:${s}px;--d:${d}s;--delay:${delay}s;--dx:${dx}px`} />
    ))
  }
</div>
