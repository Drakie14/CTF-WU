---
import poster from '../assets/desert-needle-skyline.webp';
---

<div class="skyline" data-skyline>
  <div class="skyline-art" aria-hidden="true">
    <img src={poster.src} width={poster.width} height={poster.height} alt="" decoding="async" />
    <canvas hidden></canvas>
  </div>
  <button class="skyline-playback" type="button" aria-label="Tạm dừng skyline" data-skyline-playback hidden></button>
</div>

<script>
  import type { createSkylinePlayer } from '../lib/skyline-player';

  let dispose: (() => void) | undefined;
  let current: HTMLElement | undefined;
  let pausedByUser = false;

  function mount() {
    const skyline = document.querySelector<HTMLElement>('[data-skyline]');
    if (!skyline || current === skyline) return;
    const canvas = skyline.querySelector('canvas');
    const button = skyline.querySelector('button');
    if (!canvas || !button) return;
    current = skyline;

    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let playing = !motion.matches && !pausedByUser;
    let visible = false;
    let disposed = false;
    let player: ReturnType<typeof createSkylinePlayer>;
    let loading: Promise<void> | undefined;
    const update = () => {
      button.dataset.playing = String(playing);
      button.setAttribute('aria-label', playing ? 'Tạm dừng skyline' : 'Phát skyline');
      if (!playing || !visible || document.hidden) {
        player?.pause();
        return;
      }
      if (player) {
        player.play();
        return;
      }
      loading ??= import('../lib/skyline-player').then(({ createSkylinePlayer }) => {
        if (disposed) return;
        player = createSkylinePlayer(canvas);
        if (player) update();
        else button.hidden = true;
      }).catch(() => { button.hidden = true; });
    };

    const observer = new IntersectionObserver(([entry]) => {
      visible = Boolean(entry?.isIntersecting);
      update();
    });
    observer.observe(skyline);
    button.hidden = false;
    button.addEventListener('click', () => {
      playing = !playing;
      pausedByUser = !playing;
      update();
    });
    const onPreference = () => {
      playing = !motion.matches && !pausedByUser;
      update();
    };
    motion.addEventListener('change', onPreference);
    document.addEventListener('visibilitychange', update);
    update();

    dispose = () => {
      disposed = true;
      player?.pause();
      observer.disconnect();
      motion.removeEventListener('change', onPreference);
      document.removeEventListener('visibilitychange', update);
      current = undefined;
    };
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    dispose?.();
    dispose = undefined;
  });
</script>

<style>
  .skyline {
    position: relative;
    height: clamp(6rem, 10vw, 8.5rem);
    min-width: 0;
  }
  .skyline-art {
    height: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 19%, #000 89%, transparent),
      linear-gradient(180deg, transparent, #000 15%, #000 82%, transparent);
    mask-composite: intersect;
  }
  .skyline-art img,
  .skyline-art canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 46%;
    filter: saturate(0.86);
  }
  .skyline-playback {
    position: absolute;
    right: 0.2rem;
    bottom: 0;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 0.4rem;
    background: var(--panel);
    color: var(--muted);
    cursor: var(--cur-link);
  }
  .skyline-playback:hover,
  .skyline-playback:focus-visible {
    color: var(--text);
  }
  .skyline-playback::before {
    display: block;
    width: 0;
    height: 0;
    margin: auto;
    border-block: 0.27rem solid transparent;
    border-left: 0.42rem solid currentColor;
    content: '';
  }
  .skyline-playback[data-playing='true']::before {
    width: 0.46rem;
    height: 0.55rem;
    border: 0;
    border-inline: 0.12rem solid currentColor;
  }
  @media (max-width: 639.98px) {
    .skyline { height: 4.75rem; }
    .skyline-art img,
    .skyline-art canvas { object-position: 54% 53%; }
    .skyline-playback { width: 2.75rem; height: 2.75rem; bottom: -0.2rem; }
  }
</style>
