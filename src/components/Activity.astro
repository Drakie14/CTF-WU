---
import type { ActivityDay } from '../lib/stats';

type Entry = { iso: string; title: string; href: string };

interface Props {
  columns: ActivityDay<Entry>[][];
  total: number;
  longest: number;
  categories: Array<{ key: string; label: string; color: string; count: number; href?: string }>;
}

const { columns, total, longest, categories } = Astro.props;
const level = (count: number) => Math.min(count, 3);
const display = (iso: string) => iso.split('-').reverse().join('/');
// Nhãn tháng đặt ở cột có ngày mùng 1.
const months = columns
  .map((days, x) => ({ x, day: days.find((d) => d.iso.endsWith('-01')) }))
  .filter((m): m is { x: number; day: ActivityDay<Entry> } => Boolean(m.day))
  .map(({ x, day }) => ({ x, label: `T${Number(day.iso.slice(5, 7))}` }));
const sum = categories.reduce((n, c) => n + c.count, 0);
---

<section class="activity" aria-labelledby="activity-h">
  <div class="a-head">
    <h2 id="activity-h">Hoạt động</h2>
    <p>{total} bài trong 6 tháng · chuỗi dài nhất {longest} ngày</p>
  </div>
  <div class="heatmap" style={`--cols:${columns.length}`} role="group" aria-label={`${total} bài viết trong 6 tháng qua`}>
    {months.map((m) => <span class="h-month" style={`grid-column:${m.x + 2}`}>{m.label}</span>)}
    {['T2', 'T4', 'T6'].map((label, i) => <span class="h-day" style={`grid-row:${i * 2 + 2}`}>{label}</span>)}
    {
      columns.map((days, x) =>
        days.map((d, y) =>
          d.items.length ? (
            // Ô có bài: hover/tap (focus) hiện ngay danh sách bài; nửa phải neo tooltip sang trái để không tràn panel.
            <div class:list={['cell', `lv${level(d.items.length)}`, { flip: x >= columns.length / 2 }]} style={`grid-area:${y + 2}/${x + 2}`} tabindex="0">
              <div class="tip" role="tooltip">
                <b>{display(d.iso)} · {d.items.length} bài</b>
                <ul>{d.items.map((p) => <li><a href={p.href}>{p.title}</a></li>)}</ul>
              </div>
            </div>
          ) : (
            <span class="cell lv0" style={`grid-area:${y + 2}/${x + 2}`} title={display(d.iso)}></span>
          ),
        ),
      )
    }
  </div>
  <div class="legend" aria-hidden="true">
    Ít <i class="lv0"></i><i class="lv1"></i><i class="lv2"></i><i class="lv3"></i> Nhiều
  </div>

  <div class="cats">
    <div class="cats-bar" role="img" aria-label={categories.map((c) => `${c.label} ${c.count}`).join(', ')}>
      {categories.map((c) => <span style={`flex:${c.count};--c:${c.color}`} title={`${c.label}: ${c.count}`}></span>)}
    </div>
    <ul class="cats-legend">
      {
        categories.map((c) => (
          <li style={`--c:${c.color}`}>
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            <b>{c.count}</b>
            <small>{Math.round((c.count / sum) * 100)}%</small>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .activity {
    padding: 1.3rem 1.5rem 1.4rem;
    border: 1px solid var(--panel-border);
    border-radius: 0.75rem;
    background: var(--panel-2);
    text-align: left;
  }
  .a-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    margin-bottom: 0.9rem;
  }
  .a-head h2 {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .a-head p {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-soft);
  }
  .heatmap {
    display: grid;
    grid-template-columns: 1.4rem repeat(var(--cols), minmax(0, 1fr));
    grid-template-rows: auto;
    gap: clamp(2px, 0.5vw, 4px);
  }
  .h-month,
  .h-day {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    line-height: 1;
    color: var(--muted);
    white-space: nowrap;
  }
  .h-month {
    grid-row: 1;
    padding-bottom: 0.2rem;
  }
  .h-day {
    grid-column: 1;
    align-self: center;
  }
  .cell {
    position: relative;
    aspect-ratio: 1;
    border-radius: 22%;
  }
  div.cell {
    cursor: pointer;
    transition: transform 0.12s var(--ease-out);
  }
  div.cell:hover,
  div.cell:focus-within {
    z-index: 5;
    transform: scale(1.25);
    outline: 1.5px solid var(--text);
    outline-offset: 1px;
  }
  .tip {
    position: absolute;
    bottom: calc(100% + 0.45rem);
    left: -0.4rem;
    width: max-content;
    max-width: min(17rem, 70vw);
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--panel-border);
    border-radius: 0.5rem;
    background: var(--panel);
    box-shadow: 0 0.6rem 1.6rem rgb(0 0 0 / 0.5);
    font-size: 0.72rem;
    line-height: 1.4;
    text-align: left;
    /* Bù lại scale của ô để chữ không phóng to theo. */
    transform: scale(0.8);
    transform-origin: bottom left;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.1s;
  }
  /* Cầu nối khoảng hở giữa ô và tooltip để rê chuột lên link không bị mất hover. */
  .tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.7rem;
  }
  .flip .tip {
    left: auto;
    right: -0.4rem;
    transform-origin: bottom right;
  }
  div.cell:hover .tip,
  div.cell:focus-within .tip {
    visibility: visible;
    opacity: 1;
  }
  .tip b {
    display: block;
    margin-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }
  .tip ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tip li + li {
    margin-top: 0.2rem;
  }
  .tip a {
    color: var(--text);
    text-decoration: none;
  }
  .tip a:hover,
  .tip a:focus-visible {
    color: var(--accent);
  }
  .lv0 {
    background: rgb(255 255 255 / 0.05);
  }
  .lv1 {
    background: rgb(244 114 182 / 0.35);
  }
  .lv2 {
    background: rgb(244 114 182 / 0.65);
  }
  .lv3 {
    background: var(--accent);
  }
  div.lv3 {
    box-shadow: 0 0 6px rgb(244 114 182 / 0.7);
  }
  .legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--muted);
  }
  .legend i {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
  }
  .cats {
    margin-top: 1.2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--panel-border);
  }
  .cats-bar {
    display: flex;
    gap: 3px;
    height: 0.55rem;
    border-radius: 999px;
    overflow: hidden;
  }
  .cats-bar span {
    background: var(--c);
  }
  .cats-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
  }
  .cats-legend li {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .cats-legend li::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    align-self: center;
    background: var(--c);
    transform: rotate(45deg);
  }
  .cats-legend a,
  .cats-legend span {
    color: var(--text);
    text-decoration: none;
  }
  .cats-legend a:hover {
    color: var(--c);
  }
  .cats-legend b {
    font-family: var(--font-mono);
    color: var(--c);
  }
  .cats-legend small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }
</style>
