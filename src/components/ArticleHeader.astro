---
import { categoryColor, categoryLabel } from '../lib/categories';
import { difficultyFamily } from '../lib/content/constants';
import { slugify } from '../lib/content/slug';
import { formatDisplayDate, formatIsoDate } from '../lib/content/dates';
import type { Taxonomy } from '../lib/content/tags';
import { isUnsorted, type Post } from '../lib/posts';

interface Props {
  post: Post;
  tags: Taxonomy;
  ctfs: Taxonomy;
}

const { post, tags, ctfs } = Astro.props;
const { title, ctf, category, difficulty, date, readingTime } = post.data;
---

<header class="art-head">
  <div class="art-title-row">
    <h1 class="art-title" data-pagefind-meta="title">{title}</h1>
  </div>
  <div class="art-meta" data-pagefind-ignore>
    {ctf && <a class="art-ctf" href={`/ctf/${ctfs.slugOf(ctf)}/`}>{ctf}</a>}
    {
      category && (
        <a class="badge" href={`/category/${slugify(category)}/`} style={`--c:${categoryColor(category)}`}>
          {categoryLabel(category)}
        </a>
      )
    }
    {difficulty && <span class={`badge diff diff-${difficultyFamily(difficulty)}`}>{difficulty}</span>}
    {isUnsorted(post) && <span class="badge unsorted">Chưa phân loại</span>}
  </div>
  <p class="art-sub" data-pagefind-ignore>
    <time datetime={formatIsoDate(date)}>{formatDisplayDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readingTime} phút đọc</span>
  </p>
  {
    post.data.tags.length > 0 && (
      <ul class="art-tags" aria-label="Tags" style={`--tag-c:${categoryColor(category)}`}>
        {post.data.tags.map((tag) => (
          <li>
            <a href={`/tags/${tags.slugOf(tag)}/`}>{tags.bySlug.get(tags.slugOf(tag))?.name ?? tag}</a>
          </li>
        ))}
      </ul>
    )
  }
</header>

<style>
  .art-head {
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--panel-border);
  }
  .art-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .art-title {
    margin: 0;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .art-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    margin-top: 0.8rem;
  }
  .art-ctf {
    color: var(--text-soft);
    text-decoration: none;
  }
  .art-ctf:hover {
    color: var(--accent);
  }
  .badge {
    --c: var(--accent-2);
    display: inline-block;
    padding: 0.15rem 0.7rem;
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--c) 18%, transparent);
    color: var(--c);
    font-size: 0.82rem;
    text-decoration: none;
    text-transform: capitalize;
  }
  .diff-sprout {
    --c: #86efac;
  }
  .diff-bronze {
    --c: #d6a274;
  }
  .diff-silver {
    --c: #cbd5e1;
  }
  .diff-gold {
    --c: #fcd34d;
  }
  .diff-platinum {
    --c: #5eead4;
  }
  .diff-diamond {
    --c: #7dd3fc;
  }
  .diff-master {
    --c: #f472b6;
  }
  .badge.unsorted {
    --c: var(--warn);
    text-transform: none;
  }
  .art-sub {
    display: flex;
    gap: 0.5rem;
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .art-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Cùng kiểu pill với tag ở danh sách bài (Sidebar .pill): màu theo category. */
  .art-tags a {
    display: inline-block;
    padding: 0 0.6rem;
    border: 1px solid color-mix(in srgb, var(--tag-c) 55%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--tag-c) 14%, transparent);
    color: var(--tag-c);
    font-size: 0.78rem;
    line-height: 1.6rem;
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .art-tags a:hover {
    background: color-mix(in srgb, var(--tag-c) 26%, transparent);
  }
</style>
