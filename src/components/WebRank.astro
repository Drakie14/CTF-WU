---
import { FAMILY_COLORS, type Family, type WebRank } from '../lib/stats';

interface Props {
  rank: WebRank;
}

const { rank } = Astro.props;
const fmt = (n: number) => n.toLocaleString('en-US');
const percent = Math.round(rank.progress * 100);
const families = (Object.keys(FAMILY_COLORS) as Family[]).filter((f) => rank.byFamily[f] > 0);
---

<section class="rank" style={`--tier:${rank.rank.color}`} aria-labelledby="rank-h">
  <svg class="emblem" viewBox="0 0 64 64" aria-hidden="true">
    <path class="e-ring" d="M32 2 62 32 32 62 2 32Z"></path>
    <path class="e-mid" d="M32 12 52 32 32 52 12 32Z"></path>
    <path class="e-core" d="M32 20 44 32 32 44 20 32Z"></path>
    <text class="e-num" x="32" y="32">{rank.rank.name.split(' ')[1]}</text>
  </svg>
  <div class="r-body">
    <h2 id="rank-h" class="r-label">Web rank</h2>
    <p class="r-tier">{rank.rank.name}</p>
    <p class="r-score"><b>{fmt(rank.score)}</b> pts · {rank.solved} write-up web</p>
    <div class="r-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent} aria-label="Tiến độ lên bậc kế">
      <span style={`width:${percent}%`}></span>
    </div>
    <p class="r-next">{rank.next ? `${fmt(rank.next.min - rank.score)} pts nữa lên ${rank.next.name}` : 'Đã ở bậc cao nhất'}</p>
  </div>
  <ul class="r-diff">
    {
      families.map((f) => (
        <li class={`diff-${f.toLowerCase()}`}>
          <b>{rank.byFamily[f]}</b>
          {f}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .rank {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.4rem;
    align-items: center;
    padding: 1.4rem 1.6rem;
    background:
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--tier) 16%, transparent), transparent 60%),
      var(--panel-2);
    border: 1px solid color-mix(in srgb, var(--tier) 30%, var(--panel-border));
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
    text-align: left;
  }
  .emblem {
    width: 5.5rem;
    height: 5.5rem;
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--tier) 55%, transparent));
  }
  .e-ring {
    fill: none;
    stroke: var(--tier);
    stroke-width: 2;
    opacity: 0.55;
  }
  .e-mid {
    fill: color-mix(in srgb, var(--tier) 18%, transparent);
    stroke: var(--tier);
    stroke-width: 1.5;
  }
  .e-core {
    fill: var(--tier);
  }
  .e-num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 800;
    fill: var(--panel-2);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .r-body {
    min-width: 0;
  }
  .r-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .r-tier {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tier);
    text-shadow: 0 0 18px color-mix(in srgb, var(--tier) 45%, transparent);
  }
  .r-score {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .r-score b {
    color: var(--points);
    font-family: var(--font-mono);
  }
  .r-bar {
    height: 0.45rem;
    margin-top: 0.75rem;
    background: rgb(255 255 255 / 0.07);
    border-radius: 999px;
    overflow: hidden;
  }
  .r-bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, color-mix(in srgb, var(--tier) 55%, transparent), var(--tier));
    border-radius: inherit;
    box-shadow: 0 0 10px var(--tier);
  }
  .r-next {
    margin: 0.4rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .r-diff {
    grid-column: 1 / -1;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .r-diff li {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.45rem 0.3rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    flex-wrap: wrap;
    row-gap: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .r-diff b {
    font-size: 1rem;
    letter-spacing: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .r-bar span {
      animation: grow 1.1s var(--ease-out) 0.5s backwards;
    }
    .emblem {
      animation: diamond-in 0.9s var(--ease-out) backwards;
    }
  }
  @keyframes grow {
    from {
      width: 0;
    }
  }
  @media (max-width: 480px) {
    .rank {
      padding: 1.1rem;
    }
    .emblem {
      width: 3.8rem;
      height: 3.8rem;
    }
    .r-tier {
      font-size: 1.4rem;
    }
  }
</style>
