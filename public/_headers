# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Không chứa secret. Public pages dùng CSP chặt; /admin có CSP riêng (xem cuối file).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Cache-Control: public, max-age=0, must-revalidate

# Asset có hash trong tên file: cache vĩnh viễn.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Chỉ mục Pagefind (tên file có hash, riêng entry pagefind.js/pagefind-entry.json thì không).
/pagefind/*
  Cache-Control: public, max-age=3600, must-revalidate

/bg.svg
  Cache-Control: public, max-age=86400, must-revalidate

/og.png
  Cache-Control: public, max-age=86400, must-revalidate

# File đính kèm của bài viết: luôn tải xuống, không bao giờ render/chạy trên domain của site.
/attachments/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; sandbox
  Content-Disposition: attachment
  Cache-Control: public, max-age=31536000, immutable

# Trang admin (/admin): CSP riêng, KHÔNG nới lỏng CSP của trang public.
# - script-src 'self': mọi script được bundle thành /_astro/*.js.
# - connect-src: chỉ GitHub API; img-src cho ảnh của repo và blob:/data: khi preview.
# - style-src 'unsafe-inline': Studio/CodeMirror chèn style động; không ảnh hưởng script.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' blob: data: https://*.githubusercontent.com; media-src 'self' blob:; connect-src 'self' blob: data: https://api.github.com; frame-src blob:; worker-src 'self' blob:; manifest-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Shiki dùng WebAssembly để tô màu code trong Studio. Chỉ nới CSP cho Studio;
# Các trang admin khác tiếp tục không cho phép WebAssembly/eval.
/admin/studio/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' blob: data: https://*.githubusercontent.com; media-src 'self' blob:; connect-src 'self' blob: data: https://api.github.com; frame-src blob:; worker-src 'self' blob:; manifest-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
