# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Không chứa secret. Public pages dùng CSP chặt; /admin có CSP riêng (xem cuối file).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Cache-Control: public, max-age=0, must-revalidate

# Asset có hash trong tên file: cache vĩnh viễn.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Chỉ mục Pagefind (tên file có hash, riêng entry pagefind.js/pagefind-entry.json thì không).
/pagefind/*
  Cache-Control: public, max-age=3600, must-revalidate

/bg.svg
  Cache-Control: public, max-age=86400, must-revalidate

/og.png
  Cache-Control: public, max-age=86400, must-revalidate

# File đính kèm của bài viết: luôn tải xuống, không bao giờ render/chạy trên domain của site.
/attachments/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; sandbox
  Content-Disposition: attachment
  Cache-Control: public, max-age=31536000, immutable

# Sveltia CMS (/admin): CSP riêng, KHÔNG nới lỏng CSP của trang public.
# - script-src 'self': bundle CMS được self-host (không tải từ unpkg/CDN).
# - connect-src/img-src: GitHub API + avatar/ảnh của repo; blob:/data: cho preview ảnh upload.
# - connect-src unpkg.com/@sveltia/: bundle KHÔNG kèm bản dịch giao diện, Sveltia fetch
#   locales/<ngôn-ngữ>.json từ unpkg theo ngôn ngữ trình duyệt. Bị chặn thì với trình duyệt
#   không phải tiếng Anh, CMS retry vô hạn và treo trang trắng. Chỉ là fetch JSON — script-src vẫn 'self'.
# - font-src cdn.jsdelivr.net: font giao diện CMS (Source Sans 3, Noto Mono, Material Symbols)
#   được bundle Sveltia tham chiếu cố định tới jsdelivr — chỉ là font, không phải script.
# - style-src 'unsafe-inline': Svelte chèn style động; không ảnh hưởng script.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.jsdelivr.net; img-src 'self' blob: data: https://*.githubusercontent.com; media-src 'self' blob:; connect-src 'self' blob: data: https://unpkg.com/@sveltia/ https://api.github.com https://www.githubstatus.com; frame-src blob:; worker-src 'self' blob:; manifest-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache
